@Article{Ciani2015,
  author   = {Ciani, Andrea Camperio and Battaglia, Umberto and Zanzotto, Giovanni},
  title    = {Human homosexuality: a paradigmatic arena for sexually antagonistic selection?},
  journal  = {Cold Spring Harbor Perspectives in Biology},
  year     = {2015},
  volume   = {7},
  number   = {4},
  pages    = {a017657},
  abstract = {Sexual conflict likely plays a crucial role in the origin and maintenance of homosexuality in our species. Although environmental factors are known to affect human homosexual (HS) preference, sibling concordances and population patterns related to HS indicate that genetic components are also influencing this trait in humans. We argue that multilocus, partially X-linked genetic factors undergoing sexually antagonistic selection that promote maternal female fecundity at the cost of occasional male offspring homosexuality are the best candidates capable of explaining the frequency, familial clustering, and pedigree asymmetries observed in HS male proband families. This establishes male HS as a paradigmatic example of sexual conflict in human biology. HS in females, on the other hand, is currently a more elusive phenomenon from both the empirical and theoretical standpoints because of its fluidity and marked environmental influence. Genetic and epigenetic mechanisms, the latter involving sexually antagonistic components, have been hypothesized for the propagation and maintenance of female HS in the population. However, further data are needed to truly clarify the evolutionary dynamics of this trait.},
  doi      = {10.1101/cshperspect.a017657},
  eprint   = {http://cshperspectives.cshlp.org/content/7/4/a017657.full.pdf+html},
  url      = {http://cshperspectives.cshlp.org/content/7/4/a017657.abstract},
}

