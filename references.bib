@Article{Pal2006,
  author    = {Pal Bhadra, Manika and Bhadra, Utpal and Birchler, James A.},
  title     = {Misregulation of Sex-Lethal and Disruption of Male-Specific Lethal Complex Localization in {\textit{\uppercase{D}rosophila}} Species Hybrids},
  journal   = {Genetics},
  year      = {2006},
  volume    = {174},
  number    = {3},
  pages     = {1151--1159},
  abstract  = {A major model system for the study of evolutionary divergence between closely related species has been the unisexual lethality resulting from reciprocal crosses of {\textit{\uppercase{D}rosophila}} {\textit{melanogaster}} and D. {\textit{simulans}}. Sex-lethal (Sxl), a critical gene for sex determination, is misregulated in these hybrids. In hybrid males from D. {\textit{melanogaster}} mothers, there is an abnormal expression of Sxl and a failure of localization of the male-specific lethal (MSL) complex to the {\uppercase{X}}-chromosome, which causes changes in gene expression. Introduction of a Sxl mutation into this hybrid genotype will allow expression of the MSL complex but there is no sequestration to the {\uppercase{X}}-chromosome. Lethal hybrid rescue (Lhr), which allows hybrid males from this cross to survive, corrects the SXL and MSL defects. The reciprocal cross of D. {\textit{simulans}} mothers by D. {\textit{melanogaster}} males exhibits underexpression of Sxl in embryos.},
  date      = {November 1, 2006},
  owner     = {bram},
  timestamp = {2007-02-06},
  url       = {http://www.genetics.org/cgi/content/abstract/174/3/1151},
}

