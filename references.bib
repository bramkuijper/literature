@Article{Rusche2010,
  author    = {Rusche, Laura N. and Rine, Jasper},
  title     = {Switching the mechanism of mating type switching: a domesticated transposase supplants a domesticated homing endonuclease},
  journal   = {Genes \& Development},
  year      = {2010},
  volume    = {24},
  number    = {1},
