@Article{Greeff2001,
  author    = {Greeff, Jaco M. and Nason, John D. and Compton, Stephen G.},
  title     = {Skewed paternity and sex allocation in hermaphroditic plants and animals},
  journal   = {Proceedings of the Royal Society of London. Series B: Biological Sciences},
  year      = {2001},
  volume    = {268},
  number    = {1481},
  pages     = {2143--2147},
  abstract  = {Models predict a reduced allocation to sperm when females preferentially use one of two males' sperm and the males do not know who is favoured. An analogous discounting occurs in plants when their paternity success is skewed by random, non–heritable factors such as location in the population and pollinator behaviour. We present a model that shows that skewed paternity can affect the sex allocation of hermaphrodites, that is it leads to a female–biased investment. The model highlights the close links between local mate competition and sperm competition. We use paternity data from in order to illustrate that skews in paternity success can lead to a high degree of sibling gamete competition in an apparently open breeding system. Since skews in paternity are ubiquitous in hermaphroditic plants and animals these findings should apply broadly.},
  date      = {October 22, 2001},
  doi       = {10.1098/rspb.2001.1771},
  owner     = {bram},
  timestamp = {2010-03-25},
