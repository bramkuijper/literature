@Article{Beukeboom2007a,
  author    = {Beukeboom, Leo W. and Kamping, Albert and van de Zande, Louis},
  title     = {Sex determination in the haplodiploid wasp {\emph{\uppercase{N}asonia vitripennis}} ({\uppercase{H}ymenoptera}: Chalcidoidea): a critical consideration of models and evidence},
  journal   = {Seminars in Cell \& Developmental Biology},
  year      = {2007},
  volume    = {18},
  number    = {3},
  pages     = {371--378},
  month     = jun,
  abstract  = {Sex determining mechanisms are highly diverse. Like all {\uppercase{H}ymenoptera}, the parasitic wasp Nasonia vitripennis reproduces by haplodiploidy: males are haploid and females are diploid. Sex in Nasonia is not determined by complementary alleles at sex loci. Evidence for several alternative models is considered. Recent studies on a polyploid and a gynandromorphic mutant strain point to a maternal product that is balanced against the number of chromosomal complements in the zygote and a parent-specific (imprinting) effect. Research is now focused on the molecular details of sex determination in Nasonia.},
  booktitle = {Signal Transduction in the Myometrium; Sex Determination},
  keywords  = {Genomic imprinting, {\uppercase{H}ymenoptera}, Nasonia, Polyploidy, Sex determination},
