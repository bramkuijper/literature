@Article{Johnstone1999,
  author    = {Johnstone, Rufus A. and Earn, David J. D.},
  title     = {Imperfect female choice and male mating skew on leks of different sizes},
  journal   = {Behavioral Ecology and Sociobiology},
  year      = {1999},
  volume    = {45},
  number    = {3},
  pages     = {277--281},
  month     = mar,
  abstract  = {Abstract&nbsp;&nbsp; We present a model of error-prone female choice on leks, and investigate the effects of different degrees of error on the distribution of mating success among males present at leks of different sizes. At higher levels of error, the best male is predicted to gain a smaller share of matings, while low-ranking males gain a larger share. Males who are of high rank but not the most desirable on the lek do best at intermediate levels of error, since the top-ranked male does not then claim all the matings, but assessment is still sufficiently accurate for females to discriminate between high-ranking and low-ranking competitors. The effects of error are shown to be more pronounced on larger leks, due to smaller expected differences in mating value between males of adjacent ranks. This interaction between lek size and error suggests that observed negative relationships between lek size and mating skew need not be attributed solely to intrasexual competition, as previously suggested, but could also be a result of imperfect choice.},
  owner     = {bram},
  timestamp = {2010-06-19},
  url       = {http://dx.doi.org/10.1007/s002650050562},
}

