  author    = {Hansen, A. Katie and Escobar, Linda K. and Gilbert, Lawrence E. and Jansen, Robert K.},
  title     = {Paternal, maternal, and biparental inheritance of the chloroplast genome in {\emph{\uppercase{P}assiflora}} ({\uppercase{P}assifloraceae}): implications for phylogenetic studies},
  journal   = {American Journal of Botany},
