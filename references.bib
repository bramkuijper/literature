@Article{Abbott2011,
  author    = {Abbott, Jessica K.},
  title     = {Intra-locus sexual conflict and sexually antagonistic genetic variation in hermaphroditic animals},
  journal   = {Proceedings of the Royal Society of London. Series B: Biological Sciences},
  year      = {2011},
  volume    = {278},
  number    = {1703},
  pages     = {161--169},
  abstract  = {Intra-locus sexual conflict results when sex-specific selection pressures for a given trait act against the intra-sexual genetic correlation for that trait. It has been found in a wide variety of taxa in both laboratory and natural populations, but the importance of intra-locus sexual conflict and sexually antagonistic genetic variation in hermaphroditic organisms has rarely been considered. This is not so surprising given the conceptual and theoretical association of intra-locus sexual conflict with sexual dimorphism, but there is no a priori reason why intra-locus sexual conflict cannot occur in hermaphroditic organisms as well. Here, I discuss the potential for intra-locus sexual conflict in hermaphroditic animals and review the available evidence for such conflict, and for the existence of sexually antagonistic genetic variation in hermaphrodites. I argue that mutations with asymmetric effects are particularly likely to be important in mediating sexual antagonism in hermaphroditic organisms. Moreover, sexually antagonistic genetic variation is likely to play an important role in inter-individual variation in sex allocation and in transitions to and from gonochorism (separate sexes) in simultaneous hermaphrodites. I also describe how sequential hermaphrodites may experience a unique form of intra-locus sexual conflict via antagonistic pleiotropy. Finally, I conclude with some suggestions for further research.},
  date      = {January 22, 2011},
  doi       = {10.1098/rspb.2010.1401},
  owner     = {bram},
  timestamp = {2011-04-19},
  url       = {http://rspb.royalsocietypublishing.org/content/278/1703/161.abstract},
}

