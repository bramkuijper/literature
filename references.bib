@Article{Sella1991,
  author    = {Sella, Gabriella},
  title     = {Evolution of biparental care in the hermaphroditic polychaete worm ophryotrocha diadema},
  journal   = {Evolution},
  year      = {1991},
  volume    = {45},
  number    = {1},
  pages     = {63--68},
  issn      = {00143820},
  abstract  = {Ophryotrocha diadema is a simultaneously hermaphroditic polychaete worm with a brief adolescent protandrous phase. In the mating system of this worm, pairs are formed preferentially between simultaneous hermaphrodites. Both partners of a pair regularly alternate sex roles, reciprocate egg exchange, and care for developing embryos. It was experimentally shown that neglected eggs have a 31% probability of dying, but eggs cared for by both parents, by a single parent, or even by an unrelated individual have a 95% probability of developing. In pairs experimentally prevented from caring for eggs, intruders succeeded in substituting one of the partners significantly more frequently than in pairs allowed to care for eggs. Thus, the main adaptive value of biparental care would be to guarantee a partner for egg reciprocation. Protandrous males are inefficient brooders, and biparental care becomes fully established only when individuals are able to reciprocate egg exchange, i.e., they have reached the simultaneously hermaphroditic stage.},
  owner     = {bram},
  publisher = {Society for the Study of Evolution},
  timestamp = {2009-12-14},
  url       = {http://www.jstor.org/stable/2409482},
}

@Article{Houston1991,
  author   = {Houston, Alasdair I. and McNamara, John M.},
  title    = {Evolutionarily stable strategies in the repeated hawk-dove game},
  journal  = {Behavioral Ecology},
  year     = {1991},
  volume   = {2},
  number   = {3},
  pages    = {219--227},
  abstract = {The hawk–dove game is a widely used paradigm for understanding contests between animals. We consider two models based on a series of contests for mates. In each contest, an animal can play either hawk or dove. Its strategy is characterized by the probability p that it plays hawk. Insteadof assuming a cost of fighting, we explicitly model the possibility of death as a result of a fight. One model involves a breeding season during which there is a fixed maximum possible number ofcontests. In the other model, the animal continues its attempts to breed until it dies. In both models there can be more than one evolutionarily stable strategy (ESS) for a given set of parameters. In the second model we classify the possible ESSs. Always playing hawk tends to be an ESS either when most females have to be contested or when fighting is not dangerous or a male cannot expect to live for very long even if it does not fight.},
  doi      = {10.1093/beheco/2.3.219},
  eprint   = {http://beheco.oxfordjournals.org/content/2/3/219.full.pdf+html},
  url      = {http://beheco.oxfordjournals.org/content/2/3/219.abstract},
}

