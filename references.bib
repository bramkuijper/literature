@Article{Kumar2014,
  author    = {Kumar, Rachana A. and Oldenburg, Delene J. and Bendich, Arnold J.},
  title     = {Changes in {\uppercase{DNA}} damage, molecular integrity, and copy number for plastid {\uppercase{DNA}} and mitochondrial {\uppercase{DNA}} during maize development},
  journal   = {Journal of Experimental Botany},
  year      = {2014},
  volume    = {65},
  number    = {22},
  pages     = {6425--6439},
  abstract  = {The amount and structural integrity of organellar DNAs change during plant development, although the mechanisms of change are poorly understood. Using PCR-based methods, we quantified DNA damage, molecular integrity, and genome copy number for plastid and mitochondrial DNAs of maize seedlings. A DNA repair assay was also used to assess DNA impediments. During development, DNA damage increased and molecules with impediments that prevented amplification by Taq DNA polymerase increased, with light causing the greatest change. DNA copy number values depended on the assay method, with standard real-time quantitative PCR (qPCR) values exceeding those determined by long-PCR by 100- to 1000-fold. As the organelles develop, their DNAs may be damaged in oxidative environments created by photo-oxidative reactions and photosynthetic/respiratory electron transfer. Some molecules may be repaired, while molecules with unrepaired damage may be degraded to non-functional fragments measured by standard qPCR but not by long-PCR.},
  doi       = {10.1093/jxb/eru359},
  eprint    = {http://jxb.oxfordjournals.org/content/65/22/6425.full.pdf+html},
  owner     = {bram},
  timestamp = {2015-06-05},
  url       = {http://dx.doi.org/10.1093/jxb/eru359},
}

