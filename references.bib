@Article{West1996,
  author    = {West, S. A. and Flanagan, K. E. and Godfray, H. C. J.},
  title     = {The relationship between parasitoid size and fitness in the field, a study of {\emph{\uppercase{A}chrysocharoides zwoelferi}} ({\uppercase{H}ymenoptera}: eulophidae)},
  journal   = {Journal of Animal Ecology},
  year      = {1996},
  volume    = {65},
  number    = {5},
  pages     = {631--639},
  month     = sep,
  issn      = {0021-8790},
  abstract  = {1. A knowledge of the relationship between body size and fitness is very important in many models of parasitoid behaviourial ecology. We estimated this relationship for Achrysocharoides zwoelferi ({\uppercase{H}ymenoptera}, Eulophidae), a parasitoid of leaf mining moths (Gracillariidae) on willow (Salix). 2. The size distribution of female wasps emerging from their pupae was compared with the size distribution of wasps caught while searching for hosts. A parametric statistical approach was used to obtain a function relating size to fitness. 3. Laboratory estimates of the influence of size on a component of fitness, longetivity, were obtained under two different sets of experimental conditions. 4. In the field, fitness increased rapidly with size over the first two-thirds of the observed size range, but plateaued (or possibly declined) in the last third of the range. 5. One laboratory experiment showed no effect of size on fitness while the other did show an effect although much weaker than that observed in the field. This suggests caution in using results from the laboratory in parameterising behavioural ecological models. 6. The results are compared with two other field estimates of the influence of size on fitness which show broadly similar patterns.},
  file      = {West et al 1996 JAE.pdf:/home/bram/pdf_archive/West et al 1996 JAE.pdf:PDF},
  keywords  = {clutch size, fitness, parasitoid, sex ratio, size},
  owner     = {bram},
  publisher = {British Ecological Society},
  timestamp = {2006-11-06},
  url       = {http://links.jstor.org/sici?sici=0021-8790%28199609%2965%3A5%3C631%3ATRBPSA%3E2.0.CO%3B2-U},
}

