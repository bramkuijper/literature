@Article{Carvalho2002,
  author    = {Carvalho, A. Bernardo},
  title     = {Origin and evolution of the {\textit{\uppercase{D}rosophila}} {\uppercase{Y}}-chromosome},
  journal   = {Current Opinions in Genetics \& Development},
  year      = {2002},
  volume    = {12},
  number    = {6},
  pages     = {664--668},
  month     = dec,
  abstract  = {Three recent findings are making a deep impact on our understanding of the {\textit{\uppercase{D}rosophila}} Y. First, the sequencing of the {\textit{\uppercase{D}rosophila}} genome and the development of proper computational methods increased the number of known single-copy {\uppercase{Y}}-linked genes from 1 to 16, and revealed a chromosome packed with genes acquired from the autosomes. Second, this, coupled with the finding that B-chromosomes are able to show very regular segregation from the {\uppercase{X}}-chromosome, reinforce the hypothesis that the {\textit{\uppercase{D}rosophila}} Y is a specialized B-chromosome, instead of a degenerated homologue of the X. Third and finally, Y chromosomes seem to have a strong effect on male fitness.},
