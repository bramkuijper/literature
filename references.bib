@Article{Inoue1986,
  author    = {Inoue, Hiroaki and Hiroyoshi, Toshiki},
  title     = {A maternal-effect sex-transformation mutant of the housefly, musca domestica l},
  journal   = {Genetics},
  year      = {1986},
  volume    = {112},
  number    = {3},
  pages     = {469--482},
  abstract  = {A maternal-effect sex-transformation mutant, {\textit{transformer}} ({\textit{tra}}), of the housefly is described. It is located on autosome 4 in close linkage with the Ba locus. Normally, the sex of {\textit{\uppercase{M}usca domestica}} is determined by the presence or absence of an epistatic factor, M. When produced by {\textit{tra}}/{\textit{tra}} mothers, a large fraction of the {\textit{tra}}/{\textit{tra}} genotypic female progeny carrying no M factors are transformed to develop into intersexes or fertile phenotypic males. The {\textit{tra}}/+ progeny are also transformed, but less frequently. Aging of the mothers increases the frequency of sex-transformed flies. When produced by {\textit{tra}}/+ mothers, {\textit{tra}}/{\textit{tra}} progeny (but not +/{\textit{tra}}) occasionally undergo sex transformation. Thus, {\textit{tra}}+ is active both maternally and zygotically. Genotypic males carrying the M factor are not affected by the {\textit{tra}} mutant. It is concluded that the {\textit{tra}}+ gene product is required for female determination and/or differentiation. A model is proposed to explain actions of all the known sex-determination genes in M. domestica , and it is discussed in relation to sex-determination mechanisms in several other insect species.},
  date      = {March 1, 1986},
  owner     = {bram},
  timestamp = {2006-11-17},
  url       = {http://www.genetics.org/cgi/content/abstract/112/3/469},
}

