@Article{Mead2004,
  author    = {Mead, Louise S. and Arnold, Stevan J.},
  title     = {Quantitative genetic models of sexual selection},
  journal   = {Trends in Ecology \& Evolution},
  year      = {2004},
  volume    = {19},
  number    = {5},
  pages     = {264--271},
  month     = may,
  abstract  = {Modeling of R. A. Fisher's ideas about the evolution of male ornamentation using quantitative genetics began in the 1980 s. Following an initial period of enthusiasm, interest in these models began to wane when theoretical studies seemed to show that the rapid evolution of ornaments would not occur if there were costs associated with female mate choice. Recent theoretical work has shown, however, that runaway evolution and other kinds of extensive diversification of ornaments and preferences can occur, even when female choice is costly. These new models highlight crucial parameters that profoundly influence evolutionary trajectories, but these parameters have been neglected in empirical studies. Here, we review quantitative genetic models of sexual selection with the aim of fostering communication and synergism between theoretical and empirical enterprises. We also point out several areas in which additional empirical work could distinguish between alternative models of evolution.},
  owner     = {bram},
  timestamp = {2008-04-15},
  url       = {http://www.sciencedirect.com/science/article/B6VJ1-4BX79TC-1/1/3e43e5cf42ae4759aa2cbe81663679d8},
}

