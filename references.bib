@Article{Lawniczak2007,
  author    = {Lawniczak, Mara K.N. and Barnes, Andrew I. and Linklater, Jon R. and Boone, James M. and Wigby, Stuart and Chapman, Tracey},
  title     = {Mating and immunity in invertebrates},
  journal   = {Trends in Ecology \& Evolution},
  year      = {2007},
  volume    = {22},
  number    = {1},
  pages     = {48--55},
  month     = jan,
  issn      = {0169-5347},
  abstract  = {Mating and immunity are intimately linked to fitness. In both vertebrates and invertebrates, recent investigations into mate choice for immunity, tradeoffs between reproduction and immunity, and the relationships between post-mating processes and immune function have revealed that mating and immunity are also intimately linked to each other. Here, we focus on invertebrates and critically examine the evidence that immunity is under sexual selection, both pre- and post-mating, and explore other hypotheses linking mating and immunity. We find little evidence for a consensus regarding which theories best account for the accumulating empirical data. However, we suggest that progress can quickly be made by exploiting the intrinsic strengths of invertebrate model systems.},
  doi       = {10.1016/j.tree.2006-09-012},
  owner     = {bram},
  timestamp = {2015-10-30},
}

@Article{Reise2007a,
  author    = {Reise, Heike [1] and Visser, Stefanie [1] and Hutchinson, John M. C.[2]},
