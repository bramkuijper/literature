@InCollection{Grether2010,
  author    = {Grether, Gregory F.},
  title     = {The Evolution of Mate Preferences, Sensory Biases, and Indicator Traits},
  publisher = {Academic Press},
  year      = {2010},
  editor    = {H. Jane Brockmann, Timothy J. Roper, Marc Naguib Katherine E. Wynne-Edwards John C. Mitani and Simmons, Leigh W.},
  volume    = {Volume 41},
  pages     = {35--76},
  abstract  = {Despite decades of intensive research, important discoveries continue to be made about how secondary sexual characters and mate preferences evolve. A general prediction of the mate choice indicator models is that female preferences should evolve in response to changes in the indicator value of male traits. One approach to testing this prediction is to take advantage of situations in which the indicator value of an ornament varies among genetically isolated populations in response to geographically variable environmental factors. Here I review what we have learned by studying how a female preference in guppies (Poecilia reticulata) is affected by variation in the availability of carotenoid pigments that males need to develop the preferred ornament (orange spots). The mate preference is closely linked to a sensory bias (orange attraction) that might still function in a foraging context (detection of rare orange fruit). Is the mate preference just an unmodified sensory bias, or has it been modified by selection in a mating context? Diet manipulations revealed that the mate preference and the sensory bias are both affected by the level of carotenoids in a female's diet in the direction predicted by the indicator model. Although males are also attracted to orange objects and benefit in multiple ways from consuming carotenoids, they do not exhibit the plastic response to carotenoid intake. The sex-specificity of this response strongly suggests that it evolved in a mating context. Thus, this study supports the view that mate preference evolution is a multistage process in which sensory biases that cause male ornaments to evolve may subsequently be shaped by selection in a mating context. I briefly review other examples of mate preferences for indicator traits that appear to be derived from foraging responses. Next I turn to the longstanding question of how secondary sexual characters could be evolutionarily stable indicators of mate quality and focus specifically on the problem of how cheating is prevented in species with carotenoid-based ornaments. Guppies again provide an interesting but surprisingly complex case study that illustrates the value of recognizing that color patches are multicomponent traits. Besides carotenoids, the orange spots of male guppies contain metabolically derived drosopterin pigments. Geographic variation in the carotenoid content of the orange spots is mirrored by genetic variation in drosopterin content, such that the ratio of the two types of pigments is conserved along the carotenoid availability gradient. A hue-based female preference that evolved to prevent males from substituting drosopterins for carotenoids may account for this countergradient pattern. Several related issues, such as why males combine red drosopterins with yellow carotenoids instead of converting ingested carotenoids into orange carotenoids, and the possibility that drosopterins are indicators of mate health, are also discussed. Throughout the chapter and in a concluding section, I offer suggestions for further research to extend our understanding of sexual selection and the evolution of mate preferences.},
  issn      = {0065-3454},
  keywords  = {Sexual selection, Mate preference, Mate choice, Sensory bias, Sensory exploitation, Sensory drive, Indicator trait, Handicap, Carotenoid coloration, Pteridine pigment},
  owner     = {bram},
  timestamp = {2010-08-26},
  url       = {http://www.sciencedirect.com/science/article/B7J0V-508CBN9-5/2/b0532f2147264900c1927609dbe21c55},
}

@Article{Johnstone2010,
  author    = {Johnstone, Rufus A. and Cant, Michael A.},
  title     = {The evolution of menopause in cetaceans and humans: the role of demography},
  journal   = {Proceedings of the Royal Society of London. Series B: Biological Sciences},
  year      = {2010},
  volume    = {277},
  number    = {1701},
  pages     = {3765--3771},
  abstract  = {Human females stop reproducing long before they die. Among other mammals, only pilot and killer whales exhibit a comparable period of post-reproductive life. The grandmother hypothesis suggests that kin selection can favour post-reproductive survival when older females help their relatives to reproduce. But although there is an evidence that grandmothers can provide such assistance, it is puzzling why menopause should have evolved only among the great apes and toothed whales. We have previously suggested (Cant & Johnstone 2008 Proc. Natl Acad. Sci. USA 105, 53325336 (doi:10.1073/pnas.0711911105)) that relatedness asymmetries owing to female-biased dispersal in ancestral humans would have favoured younger females in reproductive competition with older females, predisposing our species to the evolution of menopause. But this argument appears inapplicable to menopausal cetaceans, which exhibit philopatry of both sexes combined with extra-group mating. Here, we derive general formulae for kinship dynamics, the age-related changes in local relatedness that occur in long-lived social organisms as a consequence of dispersal and mortality. We show that the very different social structures of great apes and menopausal whales both give rise to an increase in local relatedness with female age, favouring late-life helping. Our analysis can therefore help to explain why, of all long-lived, social mammals, it is specifically among the great apes and toothed whales that menopause and post-reproductive helping have evolved.},
  date      = {December 22, 2010},
  doi       = {10.1098/rspb.2010.0988},
  owner     = {bram},
  timestamp = {2012-06-11},
  url       = {http://rspb.royalsocietypublishing.org/content/277/1701/3765.abstract},
}

