}

@Article{Gladden2007,
  author    = {Gladden, John Michael and Farboud, Behnom and Meyer, Barbara J.},
  title     = {Revisiting the X:A Signal that Specifies C. {\textit{elegans}} Sexual Fate},
  journal   = {Genetics},
  year      = {2007},
  pages     = {genetics.107.078071},
  abstract  = {In C. {\textit{elegans}}, sex is determined by the opposing actions of X-signal elements (XSEs) and autosomal signal elements (ASEs), which communicate the ratio of X chromosomes to sets of autosomes (X:A signal). This study has delved more deeply into the mechanism by which XSEs transmit {\uppercase{X}}-chromosome dose. We determined the relative contributions of individual XSEs to the X:A signal and showed the order of XSE strength to be sex-1 > sex-2 > fox-1 > ceh-39 [&ge;] region 1 XSE. sex-1 exerts a more potent influence on sex determination and dosage compensation than any other XSE by functioning in two separate capacities in the pathway. sex-1 acts upstream as an XSE to repress xol-1 and downstream as an activator of hermaphrodite development and dosage compensation. Furthermore, the process of dosage compensation affects expression of the very XSEs that control it; XSEs are fully dosage compensated once sex has been determined. The X:A signal then becomes equivalent between XO and {\uppercase{XX}} animals, causing sexual differentiation to be controlled by genes downstream of xol-1 in the sex determination pathway. Prior to the onset of dosage compensation, the difference in XSE expression between XO and {\uppercase{XX}} embryos appears to be greater than two-fold, making {\uppercase{X}}-chromosome counting a robust process.},
  date      = {October 18, 2007},
  owner     = {bram},
  timestamp = {2007-10-30},
  url       = {http://www.genetics.org/cgi/content/abstract/genetics.107.078071v1},
}

@Article{Ay2007,
  author    = {Ay, N. and Flack, J. and Krakauer, D.},
  title     = {Robustness and complexity co-constructed in multimodal signalling networks},
  journal   = {Philosophical Transactions: Biological Sciences},
  year      = {2007},
  volume    = {362},
  number    = {1479},
  pages     = {441--447},
  month     = mar,
  owner     = {bram},
  timestamp = {2007-03-09},
