@Article{Thornhill1980a,
  author    = {Thornhill, Randy},
  journal   = {Evolution},
  title     = {Mate choice in {\emph{\uppercase{H}ylobittacus apicalis}} ({Insecta: Mecoptera}) and its relation to some models of female choice},
  year      = {1980},
  issn      = {00143820},
  number    = {3},
  pages     = {519--538},
  volume    = {34},
  abstract  = {The behaviors surrounding the feeding of the female a prey arthropod by the male during courtship and copulation in the hangingfly, Hylobittacus apicalis, were studied in the field. Males primarily use prey sizes 16 mm2-55+ mm2 (surface area) as nuptial offerings (91% of males), and select prey sizes in this size range above the abundance of the sizes in the habitat. Males discard prey smaller than 16 mm2 before mating attempts. Females depend primarily on prey provided by males during copulation. Females prefer males as mates with prey 16 mm2-55+ mm2 and discriminate against males with smaller prey be either avoiding copulation with them or copulating for a brief period, not long enough for much sperm to be transferred. At least 9% of males are discriminated against by females. Thus female choice is potentially a strong form of selection in H apicalis. An important cost of nuptial feeding involves exposure to web-building spiders during hunting flights. Web-building spider predation is significantly male-biased in H apicalis, but not in B strigosus, a species without nuptial feeding. Females that prefer males with prey 16 mm2 or larger are more fecund and avoid exposure to web-building spider predation. Nuptial feeding by males may have been favorably selected because of reduced exposure of a male's mate to spider predators during the time she is laying eggs fertilized by the male that fed her. Female H. apicalis appear to discriminate mates primarily on the basis of nutriment gained during nuptial feeding. Aspects of mate choice in H apicalis suggest that females in addition to a direct material gain from mate choice also may be discriminating male genetic quality related to nuptial feeding behavior Fisher's (1930) runaway intersexual selection model and Zahavi's (1975) handicap principle are applicable to mate choice in H. apicalis, but do not appear to be consistent with the observations reported.},
  owner     = {bram},
  publisher = {Society for the Study of Evolution},
  timestamp = {2009-10-07},
  url       = {http://www.jstor.org/stable/2408221},
}

