@Article{Twig2008,
  author    = {Twig, Gilad and Elorza, Alvaro and Molina, Anthony J A and Mohamed, Hibo and Wikstrom, Jakob D and Walzer, Gil and Stiles, Linsey and Haigh, Sarah E and Katz, Steve and Las, Guy and Alroy, Joseph and Wu, Min and Py, B{\'e}n{\'e}dicte F and Yuan, Junying and Deeney, Jude T and Corkey, Barbara E and Shirihai, Orian S},
  title     = {Fission and selective fusion govern mitochondrial segregation and elimination by autophagy},
