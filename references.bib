@Article{Matsubara2006,
  author    = {Matsubara, Kazumi and Tarui, Hiroshi and Toriba, Michihisa and Yamada, Kazuhiko and Nishida-Umehara, Chizuko and Agata, Kiyokazu and Matsuda, Yoichi},
  title     = {Evidence for different origin of sex chromosomes in snakes, birds, and mammals and step-wise differentiation of snake sex chromosomes},
  journal   = {Proceedings of the National Academy of Sciences of the United States of America},
  year      = {2006},
  pages     = {0605274103},
  abstract  = {Edited by Mary F. Lyon, Medical Research Council, Didcot, United Kingdom, and approved September 28, 2006 (received for review June 23, 2006)All snake species exhibit genetic sex determination with the {\uppercase{ZZ}}/{\uppercase{ZW}} type of sex chromosomes. To investigate the origin and evolution of snake sex chromosomes, we constructed, by FISH, a cytogenetic map of the Japanese four-striped rat snake (Elaphe quadrivirgata) with 109 cDNA clones. Eleven of the 109 clones were localized to the Z chromosome. All human and chicken homologues of the snake {\uppercase{Z}}-linked genes were located on autosomes, suggesting that the sex chromosomes of snakes, mammals, and birds were all derived from different autosomal pairs of the common ancestor. We mapped the 11 {\uppercase{Z}}-linked genes of E. quadrivirgata to chromosomes of two other species, the Burmese python (Python molurus bivittatus) and the habu (Trimeresurus flavoviridis), to investigate the process of W chromosome differentiation. All and 3 of the 11 clones were localized to both the Z and W chromosomes in P. molurus and E. quadrivirgata, respectively, whereas no cDNA clones were mapped to the W chromosome in T. flavoviridis. Comparative mapping revealed that the sex chromosomes are only slightly differentiated in P. molurus, whereas they are fully differentiated in T. flavoviridis, and E. quadrivirgata is at a transitional stage of sex-chromosome differentiation. The differentiation of sex chromosomes was probably initiated from the distal region on the short arm of the protosex chromosome of the common ancestor, and then deletion and heterochromatization progressed on the sex-specific chromosome from the phylogenetically primitive boids to the more advanced viperids.},
  date      = {November 16, 2006},
  owner     = {bram},
  timestamp = {2006-11-24},
  url       = {http://www.pnas.org/cgi/content/abstract/0605274103v1},
}

