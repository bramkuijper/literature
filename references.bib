@Article{Wade2004,
  author    = {Wade, Michael J. and Shuster, Stephen M.},
  title     = {Sexual selection: harem size and the variance in male reproductive success},
  journal   = {The American Naturalist},
  year      = {2004},
  volume    = {164},
  number    = {4},
  pages     = {E83-E89},
  abstract  = {Sexual selection is potentially stronger than natural selection when the variance in male reproductive fitness exceeds all other components of fitness variance combined. However, measuring the variance in male reproductive fitness is difficult when nonmating males are absent, inconspicuous, or otherwise difficult to find. Omitting the nonmating males inflates estimates of average male reproductive success and diminishes the variance, leading to underestimates of the potential strength of sexual selection. We show that, in theory, the proportion of the total variance in male fitness owing to sexual selection is approximately equal to H, the mean harem size, as long as H is large and females are randomly distributed across mating males (i.e., $V_{\mathrm{harem}\,}=H$ ). In this case, mean harem size not only provides an easy way to estimate the potential strength of sexual selection but also equals the opportunity for sexual selection, Imates. In nature, however, females may be overdispersed with $V_{\mathrm{harem}\,}&lt; H$ or more aggregated than random with $V_{\mathrm{harem}\,}&gt; H$ . We show that $H+( k-1) $ is a good measure of the opportunity for sexual selection, where k is the ratio $V_{\mathrm{harem}\,}/ H$ . A review of mating system data reveals that in nature the median ratio for $V_{\mathrm{harem}\,}/ H$ is 1.04, but as H increases, females tend to become more aggregated across mating males with Vharem two to three times larger than H.},
  doi       = {10.1086/424531},
  owner     = {bram},
  timestamp = {2009-08-24},
  url       = {http://www.journals.uchicago.edu/doi/abs/10.1086/424531},
}

@Article{Derome2004,
  author    = {Derome, Nicolas and Metayer, Karine and Montchamp-Moreau, Catherine and Veuille, Michel},
  title     = {Signature of Selective Sweep Associated With the Evolution of sex-ratio Drive in {\textit{\uppercase{D}rosophila}} {\textit{simulans}}},
  journal   = {Genetics},
  year      = {2004},
  volume    = {166},
  number    = {3},
  pages     = {1357--1366},
  abstract  = {In several {\textit{\uppercase{D}rosophila}} species, the {\uppercase{XY}} Mendelian ratio is disturbed by {\uppercase{X}}-linked segregation distorters (sex-ratio drive). We used a collection of recombinants between a nondistorting chromosome and a distorting {\uppercase{X}}-chromosome originating from the Seychelles to map a candidate sex-ratio region in {\textit{\uppercase{D}rosophila}} {\textit{simulans}} using molecular biallelic markers. Our data were compatible with the presence of a sex-ratio locus in the 7F cytological region. Using sequence polymorphism at the Nrg locus, we showed that sex-ratio has induced a strong selective sweep in populations from Madagascar and Reunion, where distorting chromosomes are close to a 50% frequency. The complete association between the marker and the sex-ratio phenotype and the near absence of mutations and recombination in the studied fragment after the sweep event indicate that this event is recent. Examples of selective sweeps are increasingly reported in a number of genomes. This case identifies the causal selective force. It illustrates that all selective sweeps are not necessarily indicative of an increase in the average fitness of populations.},
  date      = {March 1, 2004},
  file      = {Derome et al 2004 Genetics.pdf:/home/bram/pdf_archive/Derome et al 2004 Genetics.pdf:PDF},
  owner     = {bram},
  timestamp = {2006-11-15},
  url       = {http://www.genetics.org/cgi/content/abstract/166/3/1357},
}

