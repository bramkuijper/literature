@Article{Asmussen2000,
  author    = {Asmussen, Marjorie A. and Orive, Maria E.},
  title     = {The effects of pollen and seed migration on nuclear-dicytoplasmic systems. \uppercase{I}. Nonrandom associations and equilibrium structure with both maternal and paternal cytoplasmic inheritance},
  journal   = {Genetics},
  year      = {2000},
  volume    = {155},
  number    = {2},
  pages     = {813--831},
  abstract  = {We determine the nuclear-dicytoplasmic effects of unidirectional gene flow via pollen and seeds upon a mixed-mating plant population, focusing on nuclear-mitochondrial-chloroplast systems where mitochondria are inherited maternally and chloroplasts paternally, as in many conifers. After first delineating the general effects of admixture (via seeds or individuals) on the nonrandom associations in such systems, we derive the full dicytonuclear equilibrium structure, including when disequilibria may be indicators of gene flow. Substantial levels of permanent two- and three-locus disequilibria can be generated in adults by (i) nonzero disequilibria in the migrant pools or (ii) intermigrant admixture effects via different chloroplast frequencies in migrant pollen and seeds. Additionally, three-locus disequilibria can be generated by higher-order intermigrant effects such as different chloroplast frequencies in migrant pollen and seeds coupled with nuclear-mitochondrial disequilibria in migrant seeds, or different nuclear frequencies in migrant pollen and seeds coupled with mitochondrial-chloroplast disequilibria in migrant seeds. Further insight is provided by considering special cases with seed or pollen migration alone, complete random mating or selfing, or migrant pollen and seeds lacking disequilibria or intermigrant admixture effects. The results complete the theoretical foundation for a new method for estimating pollen and seed migration using joint cytonuclear or dicytonuclear data.},
  eprint    = {http://www.genetics.org/content/155/2/813.full.pdf+html},
  timestamp = {2014-07-17},
  url       = {http://www.genetics.org/content/155/2/813.abstract},
}

@Article{Wachtmeister2000,
  author    = {Wachtmeister, Carl-Adam and Enquist, Magnus},
  title     = {The evolution of courtship rituals in monogamous species},
  journal   = {Behavioral Ecology},
  year      = {2000},
  volume    = {11},
  number    = {4},
  pages     = {405--410},
  abstract  = {In this paper we propose an alternative explanation for the evolution of courtship rituals in monogamous species. We demonstrate, using computer simulations, how male courtship might develop as males exploit response biases in females to manipulate the female into starting reproduction before she has been able to assess the male's intentions. In our coevolutionary simulations, a recurrent, artificial neural network is used to model the female recognition mechanism, while the displaying male is represented by a sequence of signals. Our particular model situation is just one example of how a reproductive conflict could result in the evolution of ritualized displays in monogamous species. Since reproductive conflicts occur even after pair formations, the explanation we propose may also apply to rituals that occur after pair formation.},
  date      = {July 1, 2000},
  doi       = {10.1093/beheco/11.4.405},
  owner     = {bram},
  timestamp = {2010-08-22},
  url       = {http://beheco.oxfordjournals.org/cgi/content/abstract/11/4/405},
}

