@Article{Werren1980,
  author    = {Werren, John H.},
  title     = {Sex ratio adaptations to local mate competition in a parasitic wasp},
  journal   = {Science},
  year      = {1980},
  volume    = {208},
  number    = {4448},
  pages     = {1157--1159},
  month     = jun,
  issn      = {0036-8075},
  abstract  = {Females of the parasitic wasp Nasonia vitripennis adjust the sex ratio of their broods according to whether they are a first or second wasp to parasitize a host. The first wasp produces a strong daughter bias. The second wasp adjusts the proportion of sons to the relative level of local mate competition, as predicted by a natural selection model. The results provide a quantitative test of sex ratio theory.},
