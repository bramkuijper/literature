@Article{Haag2002,
  author    = {Haag, Eric S. and Wang, Shanping and Kimble, Judith},
  title     = {Rapid Coevolution of the Nematode Sex-Determining Genes fem-3 and {\textit{tra}}-2},
  journal   = {Current Biology},
  year      = {2002},
  volume    = {12},
  number    = {23},
  pages     = {2035--2041},
  month     = dec,
  abstract  = {Unlike many features of metazoan development, sex determination is not widely conserved among phyla [1, 2 and 3]. However, the recent demonstration [4] that one gene family controls sexual development in {\textit{\uppercase{D}rosophila}}, C. {\textit{elegans}}, and vertebrates suggests that sex determination mechanisms may have evolved from a common pathway that has diverged radically since the Cambrian. Sex determination gene sequences often evolve quickly (e.g., [5, 6 and 7]), but it is not known how this relates to higher-order pathways or what selective or neutral forces are driving it. In such a rapidly evolving developmental pathway, the fate of functionally linked genes is of particular interest. To investigate a pair of such genes, we cloned orthologs of the key C. {\textit{elegans}} male-promoting gene fem-3 from two sister species, C. briggsae and C. remanei. We employed RNA interference to show that in all three species, the male-promoting function of fem-3 and its epistatic relationship with its female-promoting upstream repressor, {\textit{tra}}-2, are conserved. Consistent with this, the FEM-3 protein interacts with TRA-2 in each species, but in a strictly species-specific manner. Because FEM-3 is the most divergent protein yet described in {\textit{\uppercase{C}aenorhabditis}} and the FEM-3 binding domain of TRA-2 is itself hypervariable [8 and 9], a key protein-protein interaction is rapidly evolving in concert. Extrapolation of this result to larger phylogenetic scales helps explain the dissimilarity of the sex determination systems across phyla.},
  owner     = {bram},
  timestamp = {2006-11-16},
  url       = {http://www.sciencedirect.com/science/article/B6VRT-47F1PMR-S/2/8952a99d049cf23fcfc010d881686cf8},
}

@Article{Brown2002,
  author    = {Brown, Gillian R. and Silk, Joan B.},
  title     = {Reconsidering the null hypothesis: Is maternal rank associated with birth sex ratios in primate groups?},
  journal   = {Proceedings of the National Academy of Sciences of the United States of America},
  year      = {2002},
  volume    = {99},
  number    = {17},
  pages     = {11252--11255},
  abstract  = {Trivers and Willard hypothesized that vertebrates adaptively vary the sex ratio of their offspring in response to the mother's physical condition [Trivers, R. L. & Willard, D. (1973) Science 179, 90-92]. This hypothesis has produced considerable debate within evolutionary biology. Here we use meta-analysis techniques to evaluate claims that nonhuman primate females facultatively adjust the sex ratio of their progeny in relation to their own dominance rank in a uniform way. The magnitude of the difference in birth sex ratios of high- and low-ranking females declines as sample sizes increase, and the mean difference in birth sex ratios of high- and low-ranking females is zero. These results suggest that the observed effects could be the product of stochastic variation in small samples. These findings indicate that presently we cannot reject the null hypothesis that maternal dominance rank is unrelated to birth sex ratios.},
  date      = {August 20, 2002},
  file      = {Brown Silk 2002 PNAS.pdf:/home/bram/pdf_archive/Brown Silk 2002 PNAS.pdf:PDF},
  owner     = {bram},
  timestamp = {2006-10-27},
  url       = {http://www.pnas.org/cgi/content/abstract/99/17/11252},
}

