@Article{Wang2010a,
  author    = {Wang, Hongxia and Zhang, Suping and Li, Yang and Liu, Baozhong},
  title     = {Complete {mt\uppercase{DNA}} of {\emph{\uppercase{M}eretrix lusoria}} ({\uppercase{B}ivalvia: \uppercase{V}eneridae}) reveals the presence of an atp8 gene, length variation and heteroplasmy in the control region},
  journal   = {Comparative Biochemistry and Physiology Part D: Genomics and Proteomics},
  year      = {2010},
  volume    = {5},
  number    = {4},
  pages     = {256--264},
  month     = dec,
  issn      = {1744-117X},
  abstract  = {The complete nucleotide sequence of the mitochondrial genome of the clam Meretrix lusoria (Bivalvia: Veneridae) was determined. It comprises 20,268 base pairs (bp) and contains 13 protein-coding genes, including ATPase subunit 8 (atp8), two ribosomal RNAs, 22 transfer RNAs, and a non-coding control region. The atp8 encodes a protein of 39 amino acids. All genes are encoded on the same strand. A putative control region (CR or D-loop) was identified in the major non-coding region (NCR) between the tRNAGly and tRNAGln. A 1087 bp tandem repeat fragment was identified that comprises nearly 11 copies of a 101 bp motif and accounts for approximately 41% of the NCR. The 101 bp tandem repeat motif of the NCR can be folded into a stemâloop secondary structure. Samples of eight individuals from Hainan and Fujian provinces were collected and their NCR regions were successfully amplified and sequenced. The data revealed a highly polymorphic VNTR (variable number of tandem repeats) associated with high levels of heteroplasmy in the D-loop region. The size of the CR ranged from 1942 to 3354 bp depending upon the copy number of the repeat sequence.},
  doi       = {10.1016/j.cbd.2010-07-003},
  keywords  = {Meretrix lusoria, mtDNA, atp8, D-loop, VNTR, Heteroplasmy},
  owner     = {bram},
  timestamp = {2016-03-14},
}

