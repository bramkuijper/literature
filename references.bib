@Article{Lercher2003,
  author    = {Lercher, Martin J. and Urrutia, Araxi O. and Hurst, Laurence D.},
  title     = {Evidence That the Human {\uppercase{X}}-chromosome Is Enriched for Male-Specific but not Female-Specific Genes},
  journal   = {Molecular Biology and Evolution},
  year      = {2003},
  volume    = {20},
  number    = {7},
  pages     = {1113--1116},
  abstract  = {There is increasing evidence that X chromosomes have an unusual complement of genes, especially genes that have sex-specific expression. However, whereas in worm and fly the {\uppercase{X}}-chromosome has a dearth of male-specific genes, in mice genes that are uniquely expressed in spermatogonia are especially abundant on the {\uppercase{X}}-chromosome. Is this latter enrichment true for nongermline, male-specific genes in mammals, and is it found also for female-specific genes? Here, using SAGE data, we show (1) that tissue-specific genes tend to be more abundant on the human {\uppercase{X}}-chromosome, (2) that, controlling for this effect, genes expressed exclusively in prostate are enriched on the human {\uppercase{X}}-chromosome, and (3) that genes expressed exclusively in mammary gland and ovary are not so enriched. This we propose is consistent with Rice's model of the evolution of sexually antagonistic alleles.},
  date      = {July 1, 2003},
  owner     = {bram},
  timestamp = {2008-01-16},
  url       = {http://mbe.oxfordjournals.org/cgi/content/abstract/20/7/1113},
}

