@Article{Tagami2004,
  author    = {Tagami, Y. and Miura, K.},
  title     = {Distribution and prevalence of {\textit{\uppercase{W}olbachia}} in Japanese populations of {\uppercase{L}epidoptera}},
  journal   = {Insect Molecular Biology},
  year      = {2004},
  volume    = {13},
  number    = {4},
  pages     = {359--364},
  abstract  = {Abstract {\textit{\uppercase{W}olbachia}} are cytoplasmically inherited bacteria that are reported to infect at least 18-30% of all insect species. Our survey of {\uppercase{L}epidoptera} indicated that 44.9% of forty-nine species and 77.8% of nine families tested positive for {\textit{\uppercase{W}olbachia}} using PCR with wsp primers. Nineteen species had not been described previously as infected. In particular, although Pieris rapae, which is a common species in Japan, is infected by {\textit{\uppercase{W}olbachia}}, the prevalence was very low (3.4%) and there were some localities where {\textit{\uppercase{W}olbachia}} could not be detected. The probability of detection of {\textit{\uppercase{W}olbachia}} depends on the number of screened individuals of P. rapae. The results indicate that the actual number of species that are positive for {\textit{\uppercase{W}olbachia}} may be higher than previously reported.},
  owner     = {bram},
  timestamp = {2006-11-20},
  url       = {http://www.blackwell-synergy.com/doi/abs/10.1111/j.0962-1075.2004.00492.x},
}

@Article{Cotton2004,
  author    = {Cotton, Samuel and Fowler, Kevin and Pomiankowski, Andrew},
  journal   = {Proc R Soc Lond B Biol Sci},
  title     = {Do sexual ornaments demonstrate heightened condition-dependent expression as predicted by the handicap hypothesis?},
  year      = {2004},
  month     = apr,
  number    = {1541},
  pages     = {771--783},
  volume    = {271},
  abstract  = {The handicap hypothesis of sexual selection predicts that sexual ornaments have evolved heightened condition-dependent expression. The prediction has only recently been subject to experimental investigation. Many of the experiments are of limited value as they: (i) fail to compare condition dependence in sexual ornaments with suitable non-sexual trait controls; (ii) do not adequately account for body size variation; and (iii) typically consider no stress and extreme stress manipulations rather than a range of stresses similar to those experienced in nature. There is also a dearth of experimental studies investigating the genetic basis of condition dependence. Despite the common claim that sexual ornaments are condition-dependent, the unexpected conclusion from our literature review is that there is little support from well-designed experiments.},
  owner     = {bram},
  timestamp = {2008-01-18},
  url       = {http://dx.doi.org/10.1098/rspb.2004.2688},
}

