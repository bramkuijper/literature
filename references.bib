@Article{O'Donald1972,
  author    = {O'Donald, Peter},
  title     = {Natural Selection of Reproductive Rates and Breeding Times and Its Effect on Sexual Selection},
  journal   = {The American Naturalist},
  year      = {1972},
  volume    = {106},
  number    = {949},
  pages     = {368--379},
  issn      = {00030147},
  abstract  = {In his theory of sexual selection in birds, Darwin assumed that females breeding earlier in the breeding season would produce more offspring than those breeding later. He thought that healthier and better nourished females would come into breeding condition sooner and would also be able to rear more offspring. Males mating with the earlier females would therefore gain an advantage. Data of reproductive rates and breeding times in the Arctic skua show that the earlier breeders have the higher fitnesses. A quadratic model of the relation between fitness and breeding time gives a very close fit to the data. The results are used to estimate the selective coefficient of males who possess a sexual advantage. The sexual selection is found to be frequency dependent, and the selective coefficient increases as the males with the sexual advantage increase in frequency in the population.},
