@Article{Heimpel2008,
  author    = {Heimpel, george e. and de boer, jetske g.},
  title     = {Sex Determination in the {\uppercase{H}ymenoptera}},
  journal   = {Annual Review of Entomology},
  year      = {2008},
  volume    = {53},
  number    = {1},
  pages     = {209--230},
  abstract  = {The dominant and ancestral mode of sex determination in the {\uppercase{H}ymenoptera} is arrhenotokous parthenogenesis, in which diploid females develop from fertilized eggs and haploid males develop from unfertilized eggs. We discuss recent progress in the understanding of the genetic and cytoplasmic mechanisms that make arrhenotoky possible. The best-understood mode of sex determination in the {\uppercase{H}ymenoptera} is complementary sex determination (CSD), in which diploid males are produced under conditions of inbreeding. The gene mediating CSD has recently been cloned in the honey bee and has been named the complementary sex determiner. However, CSD is only known from 4 of 21 hymenopteran superfamilies, with some taxa showing clear evidence of the absence of CSD. Sex determination in the model hymenopteran Nasonia vitripennis does not involve CSD, but it is consistent with a form of genomic imprinting in which activation of the female developmental pathway requires paternally derived genes. Some other hymenopterans are not arrhenotokous but instead exhibit thelytoky or paternal genome elimination.},
  owner     = {bram},
  timestamp = {2008-01-27},
  url       = {http://arjournals.annualreviews.org/doi/abs/10.1146/annurev.ento.53.103106.093441},
}

