@Article{Neale1989a,
  author    = {Neale, D. B. and Sederoff, R. R.},
  title     = {Paternal inheritance of chloroplast DNA and maternal inheritance of mitochondrial DNA in loblolly pine},
  journal   = {Theoretical and Applied Genetics},
  year      = {1989},
  volume    = {77},
  number    = {2},
  pages     = {212--216},
  abstract  = {The inheritance of organelle DNAs in loblolly pine was studied by using restriction fragment length polymorphisms. Chloroplast DNA from loblolly pine is paternally inherited in pitch pine x loblolly pine hybrids. Mitochondrial DNA is maternally inherited in loblolly pine crosses. The uniparental inheritance of organelle genomes from opposite sexes within the same plant appears to be unique among those higher plants that have been tested and indicates that loblolly pine, and possibly other conifers, must have special mechanisms for organelle exclusion or degradation or both. This genetic system creates an exceptional opportunity for the study of maternal and paternal genetic lineages within a single species.},
  doi       = {10.1007/BF00266189},
