@Article{Wilson1981,
  author    = {Wilson, David Sloan and Colwell, Robert K.},
  title     = {Evolution of Sex Ratio in Structured Demes},
  journal   = {Evolution},
  year      = {1981},
  volume    = {35},
  number    = {5},
  pages     = {882--897},
  month     = sep,
  abstract  = {The evolution of biased sex ratios is modelled as a balance between group and individual selection in structured populations. Within single trait groups, no matter how small, natural selection favors a 1:1 sex ratio, as predicted by R. A. Fisher (1930). However an allele coding for a biased sex ratio can spread nonetheless, if trait groups containing a relatively high frequency of the allele contribute differentially to the global pool of dispersers. The equilibrium sex ratio is influenced by any factor that affects the differential productivity of trait groups. These include trait group size, number of generations spent within the trait group, degree of sex ratio bias among a female's offspring, variance in reproductive success among males, and population regulation within the trait group. Depending upon the ecological situation, group selection can promote a male or a female biased sex ratio. Group selection can also act on traits that influence the sex ratio of the whole trait group (as opposed to the sex ratio of one's own offspring). Biased sex ratios seem to be a common phenomenon among species whose population structure is approximated by the structured deme model. The relationship between breeding group size and sex ratio among species of hummingbird flower mites corroborates some predictions of the model, strongly implicating the role of group selection in nature.},
  issn      = {0014-3820},
  owner     = {bram},
  publisher = {Society for the Study of Evolution},
  timestamp = {2006-11-06},
  url       = {http://links.jstor.org/sici?sici=0014-3820%28198109%2935%3A5%3C882%3AEOSRIS%3E2.0.CO%3B2-L},
}

@Article{Lyttle1981,
  author    = {Lyttle, Terrence W.},
  title     = {Experimental Population Genetics Of Meiotic Drive Systems. iii. Neutralization Of Sex-Ratio Distortion In {\textit{\uppercase{D}rosophila}} Through Sex-Chromosome Aneuploidy},
  journal   = {Genetics},
  year      = {1981},
  volume    = {98},
  number    = {2},
  pages     = {317--334},
  abstract  = {Laboratory populations of {\textit{\uppercase{D}rosophila}} {\textit{melanogaster}} were challenged by pseudo-Y drive, which mimics true {\uppercase{Y}}-chromosome meiotic drive through the incorporation of Segregation Distorter (SD) in a T(Y;2) complex. This causes extreme sex-ratio distrotion and can ultimately lead to population extinction. Populations normally respond by the gradual accumulation of drive suppressors, and this reduction in strength of distortion allows the sex ratio to move closer to the optimal value of 1:1. One population monitored, however, was rapidly able to neutralize the effects of sex-ratio distortion by the accumulation of sex-chromosome aneuploids (XXY, XYY). This apparently occurs because {\uppercase{XX}}-bearing eggs, produced in relatively high numbers ([sim]4%) by XXY genotypes, become the main population source of females under strong {\uppercase{Y}}-chromosome drive. Computer simulation for a discrete generation model incorporating random mating with differences in fitness and segregation permits several predictions that can be compared to the data. First, sex-chromosome aneuploids should rapidly attain equilibrium, while stabilizing the population at [sim]60% males. This sex ratio should be roughly independent of the strength of the meiotic drive. Moreover, conditions favoring the accumulation of drive suppressors (e.g., weak distortion, slow population extinction) are insufficient for maintaining aneuploidy, while conditions favoring aneuploidy (e.g., strong distortion, low production of females) lead to population extinction before drive suppressors can accumulate. Thus, the different mechanisms for neutralizing sex-ratio distortion are complementary. In addition, Y drive and sex-chromosome aneuploidy are potentially co-adaptive, since under some conditions neither will survive alone. Finally, these results suggest the possibility that genetic variants promoting sex-chromosome nondisjunction may have a selective advantage in natural populations faced with sex-ratio distortion.},
  date      = {June 1, 1981},
  file      = {Lyttle 1981 Genetics.pdf:/home/bram/pdf_archive/Lyttle 1981 Genetics.pdf:PDF},
  owner     = {bram},
  timestamp = {2006-11-02},
  url       = {http://www.genetics.org/cgi/content/abstract/98/2/317},
}

