@Article{Rosenzweig1973,
  author    = {Rosenzweig, Michael L.},
  title     = {Evolution of the Predator Isocline},
  journal   = {Evolution},
  year      = {1973},
  volume    = {27},
  number    = {1},
  pages     = {84--94},
  abstract  = {Analysis of differential equations likely to be adequate dynamical models of exploitation reveals that as a predator population improves its exploitative proficiency, it endangers both its victim's and its own existence. However, because of the counterevolution of the victim, the system may not become extinct. In fact, a steady-state proficiency exists because both the selective death rate due to exploitation and the beneficial mutation rate change as proficiency does. If the system is stable at this proficiency, it should persist indefinitely. This stable proficiency will persist despite long term changes in the phenotypes of predator and victim. It exists even after one adds group selection and any infinite number of other evolutionary pressures to the model. The addition of other pressures allows one to deduce that the equilibrium rate of evolution in the system is the net beneficial mutation rate and is therefore nearly zero. Because of this compromise which evolution forces them to achieve, predator and victim can always be improved upon; they therefore coevolve through the eons.},
  issn      = {00143820},
  owner     = {bram},
  publisher = {Society for the Study of Evolution},
  timestamp = {2010-09-15},
  url       = {http://www.jstor.org/stable/2407121},
}

@Article{Slatkin1973,
  author    = {Slatkin, Montgomery},
  title     = {Gene flow and selection in a cline},
  journal   = {Genetics},
  year      = {1973},
  volume    = {75},
  number    = {4},
  pages     = {733--756},
  month     = jul,
  abstract  = {A model of the effect of gene flow and natural selection in a continuously distributed, infinite population is developed. Different patterns of spatial variation in selective pressures are considered, including a step change in the environment, a "pocket" in the environment and a periodically varying environment. Also, the problem of the effect of a geographic barrier to dispersal is analyzed. The results are: (1) there is a characteristic length scale of variation of gene frequencies, (see PDF). The population cannot respond to changes in environmental conditions which occur over a distance less than the characteristic length. The result does not depend either on the pattern of variation in selective pressures or on the exact shape of the dispersal function. (2) The reduction in the fitness of the heterozygote causes a cline in gene frequencies to become steeper. (3) A geographic barrier to dispersal causes a drastic change in the gene frequencies at the barrier only when almost all of the individuals trying to cross the barrier are stopped.},
  comment   = {4778791[pmid]},
  issn      = {0016-6731},
  owner     = {bram},
  timestamp = {2015-04-13},
  url       = {http://www.ncbi.nlm.nih.gov/pmc/articles/PMC1213045/},
}

