@Article{Thornton2006,
  author    = {Thornton, Kevin and Bachtrog, Doris and Andolfatto, Peter},
  title     = {X chromosomes and autosomes evolve at similar rates in {\textit{\uppercase{D}rosophila}}: No evidence for faster-X protein evolution},
  journal   = {Genome Research},
  year      = {2006},
  volume    = {16},
  number    = {4},
  pages     = {498--504},
  abstract  = {Recent data from {\textit{\uppercase{D}rosophila}} suggest that a substantial fraction of amino acid substitutions observed between species are beneficial. If these beneficial mutations are on average partially recessive, then the rate of protein evolution is predicted to be faster for {\uppercase{X}}-linked genes compared to autosomal genes (the "faster-X" hypothesis). We test this prediction by comparing rates of protein substitutions between orthologous genes, taking advantage of variations in chromosome fusions within the genus {\textit{\uppercase{D}rosophila}}. In members of the {\textit{\uppercase{D}rosophila}} {\textit{melanogaster}} species group, the chromosomal arm 3L segregates as an ordinary autosome (i.e., two homologous copies in both males and females). However, in the {\textit{\uppercase{D}rosophila}} pseudoobscura species group, this chromosomal arm has become fused to the ancestral {\uppercase{X}}-chromosome and is hemizygous in males. The faster-X hypothesis predicts that protein evolution should be faster for genes on this chromosomal arm in the D. pseudoobscura lineage, relative to the D. {\textit{melanogaster}} lineage. Here we combine new sequence data for 202 gene fragments in {\textit{\uppercase{D}rosophila}} miranda (in the pseudoobscura species group) with the completed genomes of D. {\textit{melanogaster}}, D. pseudoobscura, and {\textit{\uppercase{D}rosophila}} yakuba to show that there are no detectable differences in rates of amino acid evolution for orthologous {\uppercase{X}}-linked and autosomal genes. Our results imply that the contribution of the faster-X (if any) to the large-X effect on reproductive isolation in {\textit{\uppercase{D}rosophila}} is not due to a generally faster rate of protein evolution. The lack of a detectable faster-X effect in these species suggests either that beneficial amino acids are not partially recessive on average, or that adaptive evolution does not often use newly arising amino acid mutations.},
  date      = {April 1, 2006},
  owner     = {bram},
  timestamp = {2008-01-16},
  url       = {http://www.genome.org/cgi/content/abstract/16/4/498},
}

