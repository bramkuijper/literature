@InCollection{Maya-Panloup2007,
  author    = {Maya-Panloup, Pascale and Chretien, MarieâFranÃ§oise and Malthiery, Yves and Reynier, Pascal},
  title     = {Mitochondrial DNA in the Oocyte and the Developing Embryo},
  booktitle = {The Mitochondrion in the Germline and Early Development},
