@Article{Werren1997,
  author    = {Werren, John H.},
  title     = {Biology of {\textit{\uppercase{W}olbachia}}},
  journal   = {Annual Review of Entomology},
  year      = {1997},
  volume    = {42},
  number    = {1},
  pages     = {587--609},
  abstract  = {{\textit{\uppercase{W}olbachia}} are a common and widespread group of bacteria found in reproductive tissues of arthropods. These bacteria are transmitted through the cytoplasm of eggs and have evolved various mechanisms for manipulating reproduction of their hosts, including induction of reproductive incompatibility, pathenogenesis, and feminization. {\textit{\uppercase{W}olbachia}} are also transmitted horizontally between arthropod species. Significant recent advances have been made in the study of these interesting microorganisms. In this paper, {\textit{\uppercase{W}olbachia}} biology is reviewed, including their phylogeny and distribution, mechanisms of action, population biology and evolution, and biological control implications. Potential directions for future research are also discussed.},
  owner     = {bram},
  timestamp = {2007-08-03},
  url       = {http://arjournals.annualreviews.org/doi/abs/10.1146/annurev.ento.42.1.587},
}

