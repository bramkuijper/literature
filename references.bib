@Article{Charlesworth1991,
  author    = {Charlesworth, Brian},
  title     = {The evolution of sex chromosomes},
  journal   = {Science},
  year      = {1991},
  volume    = {251},
  number    = {4997},
  pages     = {1030--1033},
  month     = mar,
  abstract  = {Structurally distinct sex chromosomes (X and Y) are the most familiar mode of genetic sex determination and have evolved independently in many different taxa. The evolutionary paths by which their characteristic properties may have evolved are reviewed. These properties include the failure of X and Y to recombine through much or all of their length, the genetic inertness of much of the {\uppercase{Y}}-chromosome, dosage compensation of the activity of {\uppercase{X}}-chromosomal loci, and the accumulation of repeated DNA sequences on the {\uppercase{Y}}-chromosome.},
