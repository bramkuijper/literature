@Article{Hayasaka1991,
  author    = {Hayasaka, K and Ishida, T and Horai, S},
  title     = {Heteroplasmy and polymorphism in the major noncoding region of mitochondrial {\uppercase{DNA}} in \uppercase{J}apanese monkeys: association with tandemly repeated sequences.},
  journal   = {Molecular Biology and Evolution},
  year      = {1991},
  volume    = {8},
