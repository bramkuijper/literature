@Article{Xiong2013,
  author    = {Xiong, Haoyu and Barker, Stephen C. and Burger, Thomas D. and Raoult, Didier and Shao, Renfu},
  title     = {Heteroplasmy in the mitochondrial genomes of human lice and ticks revealed by high throughput sequencing},
  journal   = {PLoS ONE},
  year      = {2013},
  volume    = {8},
  number    = {9},
  pages     = {e73329},
  month     = sep,
  abstract  = {The typical mitochondrial (mt) genomes of bilateral animals consist of 37 genes on a single circular chromosome. The mt genomes of the human body louse, <italic>Pediculus humanus</italic>, and the human head louse, <italic>Pediculus capitis</italic>, however, are extensively fragmented and contain 20 minichromosomes, with one to three genes on each minichromosome. Heteroplasmy, i.e. nucleotide polymorphisms in the mt genome within individuals, has been shown to be significantly higher in the mt <italic>cox1</italic> gene of human lice than in humans and other animals that have the typical mt genomes. To understand whether the extent of heteroplasmy in human lice is associated with mt genome fragmentation, we sequenced the entire coding regions of all of the mt minichromosomes of six human body lice and six human head lice from Ethiopia, China and France with an Illumina HiSeq platform. For comparison, we also sequenced the entire coding regions of the mt genomes of seven species of ticks, which have the typical mitochondrial genome organization of bilateral animals. We found that the level of heteroplasmy varies significantly both among the human lice and among the ticks. The human lice from Ethiopia have significantly higher level of heteroplasmy than those from China and France (P<sub>t</sub>&lt;0.05). The tick, <italic>Amblyomma cajennense</italic>, has significantly higher level of heteroplasmy than other ticks (P<sub>t</sub>&lt;0.05). Our results indicate that heteroplasmy level can be substantially variable within a species and among closely related species, and does not appear to be determined by single factors such as genome fragmentation.},
  doi       = {10.1371/journal.pone.0073329},
  owner     = {bram},
  publisher = {Public Library of Science},
  timestamp = {2015-06-12},
  url       = {http://dx.doi.org/10.1371/journal.pone.0073329},
}

@Article{Rice2013a,
  author    = {Rice, Danny W. and Alverson, Andrew J. and Richardson, Aaron O. and Young, Gregory J. and Sanchez-Puerta, M. Virginia and Munzinger, Jérôme and Barry, Kerrie and Boore, Jeffrey L. and Zhang, Yan and dePamphilis, Claude W. and Knox, Eric B. and Palmer, Jeffrey D.},
  title     = {Horizontal transfer of entire genomes via mitochondrial fusion in the angiosperm {\emph{\uppercase{A}mborella}}},
  journal   = {Science},
  year      = {2013},
  volume    = {342},
  number    = {6165},
  pages     = {1468--1473},
  abstract  = {We report the complete mitochondrial genome sequence of the flowering plant Amborella trichopoda. This enormous, 3.9-megabase genome contains six genome equivalents of foreign mitochondrial DNA, acquired from green algae, mosses, and other angiosperms. Many of these horizontal transfers were large, including acquisition of entire mitochondrial genomes from three green algae and one moss. We propose a fusion-compatibility model to explain these findings, with Amborella capturing whole mitochondria from diverse eukaryotes, followed by mitochondrial fusion (limited mechanistically to green plant mitochondria) and then genome recombination. Amborella's epiphyte load, propensity to produce suckers from wounds, and low rate of mitochondrial DNA loss probably all contribute to the high level of foreign DNA in its mitochondrial genome.},
  doi       = {10.1126/science.1246275},
  eprint    = {http://www.sciencemag.org/content/342/6165/1468.full.pdf},
  timestamp = {2014-02-26},
  url       = {http://dx.doi.org/10.1126/science.1246275},
}

