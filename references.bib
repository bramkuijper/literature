@Article{Turelli2000,
  author    = {Turelli, Michael and Orr, H. Allen},
  journal   = {Genetics},
  title     = {Dominance, epistasis and the genetics of postzygotic isolation},
  year      = {2000},
  issn      = {0016-6731},
  number    = {4},
  pages     = {1663--1679},
  volume    = {154},
  abstract  = {The sterility and inviability of species hybrids can be explained by between-locus {\textquotedblleft}Dobzhansky-Muller{\textquotedblright} incompatibilities: alleles that are fit on their {\textquotedblleft}normal{\textquotedblright} genetic backgrounds sometimes lower fitness when brought together in hybrids. We present a model of two-locus incompatibilities that distinguishes among three types of hybrid interactions: those between heterozygous loci (H0), those between a heterozygous and a homozygous (or hemizygous) locus (H1), and those between homozygous loci (H2). We predict the relative fitnesses of hybrid genotypes by calculating the expected numbers of each type of incompatibility. We use this model to study Haldane{\textquoteright}s rule and the large effect of X chromosomes on postzygotic isolation. We show that the severity of H0 vs. H1 incompatibilities is key to understanding Haldane{\textquoteright}s rule, while the severity of H1 vs. H2 incompatibilities must also be considered to explain large X effects. Large X effects are not inevitable in backcross analyses but rather{\textemdash}like Haldane{\textquoteright}s rule{\textemdash}may often reflect the recessivity of alleles causing postzygotic isolation. We also consider incompatibilities involving the Y (or W) chromosome and maternal effects. Such incompatibilities are common in Drosophila species crosses, and their consequences in male- vs. female-heterogametic taxa may explain the pattern of exceptions to Haldane{\textquoteright}s rule.},
  eprint    = {http://www.genetics.org/content/154/4/1663.full.pdf},
  owner     = {bram},
  publisher = {Genetics},
  timestamp = {2016-06-05},
  url       = {http://www.genetics.org/content/154/4/1663},
}

