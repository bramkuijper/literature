@Article{Vaiman2000,
  author    = {Vaiman, Daniel and Pailhoux, Eric},
  title     = {Mammalian sex reversal and intersexuality: deciphering the sex-determination cascade},
  journal   = {Trends in Genetics},
  year      = {2000},
  volume    = {16},
  number    = {11},
  pages     = {488--494},
  month     = nov,
  abstract  = {The sex-determination cascade constitutes a model of the exquisite mechanisms of gene regulation that lead to the development of mammalian embryos. The discovery of the sex-determining region of the {\uppercase{Y}}-chromosome (SRY) in the early 1990s was the first crucial step towards a general understanding of sex determination. Since then, several genes that encode proteins with a role in this cascade, such as WT1, SF-1, SOX9, DAX-1 and WNT4, have been identified. Many of the interactions between these proteins have still to be elucidated, while, no-doubt, others are still to be identified. The study of mammalian intersexes forms a promising way towards the identification of the still-missing genes and a comprehensive view of mammalian sex determination. Intersexuality in the goat, studied for over a century, will, presumably, bring to light new genes involved in the female sex-determination pathway.},
  owner     = {bram},
  timestamp = {2006-11-22},
  url       = {http://www.sciencedirect.com/science/article/B6TCY-41WT6H3-9/2/772a252e1f925a0da22d89f2de91842f},
}

