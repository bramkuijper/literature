@Article{Reeve2003a,
  author    = {Reeve, Hudson Kern and Pfennig, David W.},
  title     = {Genetic biases for showy males: are some genetic systems especially conducive to sexual selection?},
  journal   = {Proceedings of the National Academy of Sciences of the United States of America},
  year      = {2003},
  volume    = {100},
  number    = {3},
  pages     = {1089--1094},
  abstract  = {Male secondary sexual characters (conspicuous ornaments, signals, colors) are among nature's most striking features. Yet, it is unclear why certain groups of organisms are more likely than others to evolve these traits. One explanation for such taxonomic biases is that some genetic systems may be especially conducive to sexual selection. Here, we present theory and simulation results demonstrating that rare alleles encoding either male ornaments or female preferences for those ornaments are better protected against random loss in species with {\uppercase{ZZ}}/{\uppercase{ZW}} or {\uppercase{ZZ}}/ZO sex chromosome systems (male homogamety) than in species with {\uppercase{XX}}/{\uppercase{XY}} or {\uppercase{XX}}/XO systems (male heterogamety). Moreover, this protection is much stronger in diploid than haplodiploid species. We also present empirical data showing that male secondary sexual characters are better developed in diploid than haplodiploid species and in diploid species with male homogamety than in those with male heterogamety. Thus, taxonomic biases for showy males may stem from differences in sex chromosome systems.},
  date      = {February 4, 2003},
  owner     = {bram},
  timestamp = {2008-01-22},
  url       = {http://www.pnas.org/cgi/content/abstract/100/3/1089},
}

