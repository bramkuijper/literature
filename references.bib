@Article{Veltsos2017,
  author    = {Veltsos, Paris and Fang, Yongxiang and Cossins, Andrew R. and Snook, Rhonda R. and Ritchie, Michael G.},
  title     = {Mating system manipulation and the evolution of sex-biased gene expression in Drosophila},
  journal   = {Nature Communications},
  year      = {2017},
  volume    = {8},
  number    = {1},
  pages     = {2072},
  month     = dec,
  issn      = {2041-1723},
  abstract  = {Sex differences in dioecious animals are pervasive and result from gene expression differences. Elevated sexual selection has been predicted to increase the number and expression of male-biased genes, and experimentally imposing monogamy on Drosophila melanogaster has led to a relative feminisation of the transcriptome. Here, we test this hypothesis further by subjecting another polyandrous species, D. pseudoobscura, to 150 generations of experimental monogamy or elevated polyandry. We find that sex-biased genes do change in expression but, contrary to predictions, there is usually masculinisation of the transcriptome under monogamy, although this depends on tissue and sex. We also identify and describe gene expression changes following courtship experience. Courtship often influences gene expression, including patterns in sex-biased gene expression. Our results confirm that mating system manipulation disproportionately influences sex-biased gene expression but show that the direction of change is dynamic and unpredictable.},
  doi       = {10.1038/s41467-017-02232-6},
  owner     = {bram},
  refid     = {Veltsos2017},
  timestamp = {2018.04.22},
  url       = {https://doi.org/10.1038/s41467-017-02232-6},
}

@Article{Felsenstein1976,
  author    = {Felsenstein, Joseph and Yokoyama, Shozo},
  title     = {The evolutionary advantage of recombination. {\uppercase{II}}. {\uppercase{I}ndividual} selection for recombination},
  journal   = {Genetics},
  year      = {1976},
  volume    = {83},
  number    = {4},
  pages     = {845--859},
  issn      = {0016-6731},
  abstract  = {Based on the Fisher-Muller theory of the evolution of recombination, an argument can be constructed predicting that a recessive allele favoring recombination will be favored, if there are either favorable or deleterious mutants occurring at other loci. In this case there is no clear distinction between individual and group selection. Computer simulation of populations segregating for recessive or dominant recombination alleles showed selection favoring recombination, except in the case of a dominant recombination allele with deleterious background mutants. The relationship of this work to parallel investigations by Williams and by Strobeck, Maynard Smith, and Charlesworth is explored. All seem to rely on the same phenomenon. There seems no reason to assume that the evolution of recombination must have occurred by group selection.},
  eprint    = {http://www.genetics.org/content/83/4/845.full.pdf},
  owner     = {bram},
  publisher = {Genetics},
  timestamp = {2018.04.30},
  url       = {http://www.genetics.org/content/83/4/845},
}

