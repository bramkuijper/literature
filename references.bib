@Article{Payer2008,
  author    = {Payer, Bernhard and Lee, Jeannie T.},
  title     = {X Chromosome Dosage Compensation: How Mammals Keep the Balance},
  journal   = {Ann Rev Genet},
  year      = {2008},
  volume    = {42},
  number    = {1},
  pages     = {733--},
  month     = dec,
  abstract  = {The development of genetic sex determination and cytologically distinct sex chromosomes leads to the potential problem of gene dosage imbalances between autosomes and sex chromosomes and also between males and females. To circumvent these imbalances, mammals have developed an elaborate system of dosage compensation that includes both upregulation and repression of the X chromosome. Recent advances have provided insights into the evolutionary history of how both the imprinted and random forms of X chromosome inactivation have come about. Furthermore, our understanding of the epigenetic switch at the X-inactivation center and the molecular aspects of chromosome-wide silencing has greatly improved recently. Here, we review various facets of the ever-expanding field of mammalian dosage compensation and discuss its evolutionary, developmental, and mechanistic components.},
  owner     = {bram},
  publisher = {Annual Reviews},
  timestamp = {2009-03-11},
  url       = {http://dx.doi.org/10.1146/annurev.genet.42.110807.091711},
}

@Article{Hense2007,
  author    = {Hense, Winfried and Baines, John F. and Parsch, John},
  title     = {{\uppercase{X}}-chromosome Inactivation during {\textit{\uppercase{D}rosophila}} Spermatogenesis},
  journal   = {PLoS Biology},
  year      = {2007},
  volume    = {5},
  number    = {10},
  pages     = {e273},
  abstract  = {Genes with male- and testis-enriched expression are under-represented on the {\textit{\uppercase{D}rosophila}} {\textit{melanogaster}} {\uppercase{X}}-chromosome. There is also an excess of retrotransposed genes, many of which are expressed in testis, that have &#8220;escaped&#8221; the {\uppercase{X}}-chromosome and moved to the autosomes. It has been proposed that inactivation of the {\uppercase{X}}-chromosome during spermatogenesis contributes to these patterns: genes with a beneficial function late in spermatogenesis should be selectively favored to be autosomal in order to avoid inactivation. However, conclusive evidence for X inactivation in the male germline has been lacking. To test for such inactivation, we used a transgenic construct in which expression of a lacZ reporter gene was driven by the promoter sequence of the autosomal, testis-specific ocnus gene. Autosomal insertions of this transgene showed the expected pattern of male- and testis-specific expression. {\uppercase{X}}-linked insertions, in contrast, showed only very low levels of reporter gene expression. Thus, we find that X linkage inhibits the activity of a testis-specific promoter. We obtained the same result using a vector in which the transgene was flanked by chromosomal insulator sequences. These results are consistent with global inactivation of the {\uppercase{X}}-chromosome in the male germline and support a selective explanation for {\uppercase{X}}-chromosome avoidance of genes with beneficial effects late in spermatogenesis.},
  date      = {October 01, 2007},
  owner     = {bram},
  timestamp = {2007-10-29},
  url       = {http://dx.doi.org/10.1371%2Fjournal.pbio.0050273},
}

