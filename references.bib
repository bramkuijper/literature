@Article{Kageyama2002,
  author    = {Kageyama, D. and Nishimura, G. and Hoshizaki, S. and Ishikawa, Y.},
  title     = {Feminizing {\textit{\uppercase{W}olbachia}} in an insect, Ostrinia furnacalis ({\uppercase{L}epidoptera} : Crambidae)},
  journal   = {Heredity},
  year      = {2002},
  volume    = {88},
  pages     = {444--449},
  month     = jun,
  abstract  = {{\textit{\uppercase{W}olbachia}}, which forms a group of maternally inherited bacteria in arthropods, often cause reproduction alterations in their hosts, such as cytoplasmic incompatibility, parthenogenesis, male-killing, hybrid breakdown and feminization. To date, {\textit{\uppercase{W}olbachia}}-induced feminization has been reported only in isopods. Here we report that a {\textit{\uppercase{W}olbachia}} strain feminizes an insect host, Ostrinia furnacalis. Among 79 wild females of O. furnacalis examined, {\textit{\uppercase{W}olbachia}} infection was detected in 13 females. Twelve of the 13 infected females produced all-female progenies, and this trait was maternally inherited. Tetracycline treatment of thelygenic matrilines resulted in the production of all-male progenies. The present findings indicate that the {\textit{\uppercase{W}olbachia}} infection induces feminization of genetic males in O. furnacalis. Differences in the {\textit{\uppercase{W}olbachia}}-induced feminization in O. furnacalis and that in isopods are discussed along with the differences in sex determination mechanisms between insects and isopods. Phylogenetic analysis of the wsp gene sequence of {\textit{\uppercase{W}olbachia}} suggests independent evolutionary origins for the {\textit{\uppercase{W}olbachia}}-induced feminizations in O. furnacalis and in isopods. Our findings over 5 years suggest that the infection has been maintained at a low prevalence in the O. furnacalis population.},
  de        = {feminization; {\uppercase{L}epidoptera}; Ostrinia furnacalis; sex-ratio distorter;EOLEOLWolbachia},
  keywords  = {PHYLOGENETIC ANALYSIS; SEX-RATIO; WSP GENE; BACTERIA; INCOMPATIBILITY; EVOLUTION; ISOPOD},
  owner     = {bram},
  pn        = {Part 6},
  timestamp = {2006-11-20},
  ut        = {ISI:000176362400005},
}

