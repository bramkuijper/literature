@Article{McAllister2000,
  author    = {McAllister, Bryant F. and McVean, Gilean A. T.},
  title     = {Neutral Evolution of the Sex-Determining Gene {\textit{transformer}} in {\textit{\uppercase{D}rosophila}}},
  journal   = {Genetics},
  year      = {2000},
  volume    = {154},
  number    = {4},
  pages     = {1711--1720},
  abstract  = {The amino acid sequence of the {\textit{transformer}} ({\textit{tra}}) gene exhibits an extremely rapid rate of evolution among {\textit{\uppercase{D}rosophila}} species, although the gene performs a critical step in sex determination. These changes in amino acid sequence are the result of either natural selection or neutral evolution. To differentiate between selective and neutral causes of this evolutionary change, analyses of both intraspecific and interspecific patterns of molecular evolution of {\textit{tra}} gene sequences are presented. Sequences of 31 {\textit{tra}} alleles were obtained from {\textit{\uppercase{D}rosophila}} americana. Many replacement and silent nucleotide variants are present among the alleles; however, the distribution of this sequence variation is consistent with neutral evolution. Sequence evolution was also examined among six species representative of the genus {\textit{\uppercase{D}rosophila}}. For most lineages and most regions of the gene, both silent and replacement substitutions have accumulated in a constant, clock-like manner. In exon 3 of D. virilis and D. americana we find evidence for an elevated rate of nonsynonymous substitution, but no statistical support for a greater rate of nonsynonymous relative to synonymous substitutions. Both levels of analysis of the {\textit{tra}} sequence suggest that, although the gene is evolving at a rapid pace, these changes are neutral in function.},
  date      = {April 1, 2000},
  owner     = {bram},
  timestamp = {2006-11-16},
  url       = {http://www.genetics.org/cgi/content/abstract/154/4/1711},
}

