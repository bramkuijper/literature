@Article{Haig1993,
  author    = {Haig, David},
  title     = {The evolution of unusual chromosomal systems in {\uppercase{c}occoids}: extraordinary sex ratios revisited},
  journal   = {Journal of Evolutionary Biology},
  year      = {1993},
  volume    = {6},
  number    = {1},
  pages     = {69--77},
  abstract  = {Abstract Coccoids (scale insects) exhibit a wide variety of chromosomal systems. In many species, paternal chromosomes are eliminated from the male germline such that all of a male's sperm transmit an identical set of maternal chromosomes. In such species, an offspring's sex is determined by whether or not paternal chromosomes are inactivated in the egg's cytoplasm after fertilization. This paper presents a model of the evolution of paternal genome loss in coccoids from an ancestral system of {\uppercase{XX}}-XO sex determination. The model is based on Hamilton's (1967) theory that different genetic elements within the genome have different unbeatable sex ratios. In this model (1) meiotic drive by the {\uppercase{X}}-chromosome in XO males causes female-biased sex ratios; (2) the maternal set of autosomes in males evolves effective sex linkage to exploit X-drive; and (3) genes expressed in mothers are selected to convert some of their {\uppercase{XX}} daughters into sons. A similar model may explain the evolution of haplodiploidy.},
  file      = {Haig 1993 JEB.pdf:/home/bram/pdf_archive/Haig 1993 JEB.pdf:PDF},
  owner     = {bram},
  timestamp = {2006-11-24},
  url       = {http://www.blackwell-synergy.com/doi/abs/10.1046/j.1420-9101.1993.6010069.x},
}

@Article{Haig1993a,
  author    = {Haig, David},
  title     = {The evolution of unusual chromosomal systems in {\uppercase{S}}ciarid flies: intragenomic conflict and the sex ratio},
  journal   = {Journal of Evolutionary Biology},
  year      = {1993},
  volume    = {6},
  number    = {2},
  pages     = {249--261},
  abstract  = {Abstract A model is presented for the evolution of the sciarid chromosomal system. In this model, a driving {\uppercase{X}}-chromosome caused female-biased sex ratios. The drive was exploited by maternal autosomes that segregated with the X at spermatogenesis. Genes in mothers converted some of their {\uppercase{XX}} daughters into sons by eliminating a paternal X from the embryonic soma. L chromosomes were derived from X chromosomes and favored male-biased sex ratios. An X' chromosome arose that suppressed the effects of L chromosomes. The 1:1 sex ratio is a stalemate between the X' and X'X mothers causing all-female broods and the L chromosomes in {\uppercase{XX}} mothers causing all-male broods. Any element (such as an L chromosome) that is preferentially transmitted through one sex will be selected to bias the sex ratio towards this sex.},
  file      = {Haig 1993 JEB - Sciarid flies.pdf:/home/bram/pdf_archive/Haig 1993 JEB - Sciarid flies.pdf:PDF},
  owner     = {bram},
  timestamp = {2006-11-24},
