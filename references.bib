@Article{Telschow2005,
  author    = {Telschow, A. and Engelst{\"a}dter, J. and Yamamura, N. and Hammerstein, P. and Hurst, G. D. D.},
  title     = {Asymmetric gene flow and constraints on adaptation caused by sex ratio distorters},
  journal   = {Journal of Evolutionary Biology},
  year      = {2005},
  volume    = {19},
  number    = {3},
  pages     = {869--878},
  month     = dec,
  issn      = {1010-061X},
  abstract  = {Abstract Asymmetric gene flow is generally believed to oppose natural selection and potentially impede adaptation. Whilst the cause of asymmetric gene flow has been seen largely in terms of variation in population density over space, asymmetric gene flow can also result from varying sex ratios across subpopulations with similar population sizes. We model the process of adaptation in a scenario in which two adjacent subpopulations have different sex ratios, associated with different levels of infection with maternally inherited endosymbionts that selectively kill male hosts. Two models are analyzed in detail. First, we consider one host locus with two alleles, each of which possesses a selective advantage in one of the subpopulations. We found that local adaptation can strongly be impeded in the subpopulation with the more female biased population sex ratio. Second, we analyze host alleles that provide resistance against the male?killing (MK) endosymbionts and show that asymmetric gene flow can prevent the spread of such alleles under certain conditions. These results might have important implications for the coevolution of MK bacteria and their hosts.},
  comment   = {doi: 10.1111/j.1420-9101.2005.01049.x},
  doi       = {10.1111/j.1420-9101.2005.01049.x},
  keywords  = {biodiversity, gene flow, maleâkilling, migration rate, resistance, Wolbachia},
