@Article{Ehlers2005,
  author    = {Ehlers, Bodil K and Maurice, Sandrine and Bataillon, Thomas},
  title     = {Sex inheritance in gynodioecious species: a polygenic view},
  journal   = {Proceedings of the Royal Society of London B: Biological Sciences},
  year      = {2005},
  volume    = {272},
  number    = {1574},
  pages     = {1795--1802},
  abstract  = {Bodil K Ehlers1*, Sandrine Maurice2 and Thomas Bataillon3,41Department of Ecology and Genetics, University of AarhusNy Munkegade, Building 540, 8000 Aarhus C, Denmark2ISEM, Universit{\'e} Montpellier IIPlace Eug{\`e}ne Bataillon, 34095 Montpellier, France3UMR 1097 {\textquotedblleft}Diversit{\'e} et G{\'e}nomes des Plantes Cultiv{\'e}es{\textquotedblright}, Domaine de Melgueil34130 Mauguio, France4BiRC, University of AarhusH{\o}egh-Guldbergs Gade, Building 090, 8000 Aarhus C, DenmarkAuthor for correspondence (bodil.ehlers{at}biology.au.dk)AbstractGynodioecy is defined as the coexistence of two different sexual morphs in a population: females and hermaphrodites. This breeding system is found among many different families of angiosperms and is usually under nucleo-cytoplasmic inheritance, with maternally inherited genes causing male sterility and nuclear factors restoring male fertility. Numerous theoretical models have investigated the conditions for the stable coexistence of females and hermaphrodites. To date, all models rest on the assumption that restoration of a given male sterile genotype is controlled by a single Mendelian factor. Here, we review data bearing on the genetic determinism of sex inheritance in three gynodiecious plant species. We suggest that restoration of male fertility is probably best viewed as a quantitative trait controlled by many loci. We develop a threshold model that accommodates an underlying polygenic trait, which is resolved at the phenotypic level in discrete sexual morphs. We use this model to reanalyse data in Thymus vulgaris, Silene vulgaris and Plantago coronopus. A simple Mendelian inheritance of sex determinism is unlikely in all three species. We discuss how our model can shed additional light on the genetics of restoration and point towards future efforts in the modelling of gynodioecy.Keywords: cytoplasmic male sterilityquantitative threshold modelsex determinationFootnotesThe three authors contributed equally to this work.Received March 1, 2005.Accepted May 21, 2005.{\textcopyright} 2005 The Royal Society},
  doi       = {10.1098/rspb.2005.3168},
  isbn      = {1471-2954},
  issn      = {0962-8452},
  owner     = {bram},
  publisher = {The Royal Society},
  timestamp = {2015-01-18},
}

