  number    = {1},
  pages     = {42--46},
  abstract  = {Patterns of inheritance of the chloroplast genome in Passiflora were analyzed by examining the progeny from both interspecific and intraspecific crosses. Artificial crosses of field-collected material were performed in greenhouses at The University of Texas at Austin. DNA from fresh leaf material was analyzed by Southern blot techniques to identify the donor of the chloroplast genome. Initially, single progeny were analyzed for 11 crosses; two intraspecific crosses demonstrated maternal inheritance, whereas the nine interspecific crosses had paternal inheritance. Subsequently, the donor of the chloroplast genome was determined for multiple progeny in seven crosses. Passiflora oerstedii × P. retipetala showed strict paternal inheritance in all of 17 progeny. A series of five crosses and backcrosses between P. oerstedii and P. menispermifolia demonstrated strictly paternal inheritance. Finally, when 15 progeny were analyzed for the P. costaricensis × P. costaricensis cross, 12 of the 15 showed maternal inheritance, whereas the remaining three were biparental. Interestingly, all interspecific crosses had primarily paternal inheritance, whereas all intraspecific crosses had primarily maternal inheritance. The implications of heteroplasmy on phylogenetic analyses of chloroplast DNA are discussed.},
  doi       = {10.3732/ajb.94.1.42},
  eprint    = {http://www.amjbot.org/content/94/1/42.full.pdf+html},
  owner     = {bram},
  timestamp = {2015-02-16},
  url       = {http://dx.doi.org/10.3732/ajb.94.1.42},
}

