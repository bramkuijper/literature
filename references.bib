@Article{Bachtrog2003a,
  author    = {Bachtrog, Doris},
  title     = {Protein Evolution and Codon Usage Bias on the Neo-Sex Chromosomes of {\textit{\uppercase{D}rosophila}} miranda},
  journal   = {Genetics},
  year      = {2003},
  volume    = {165},
  number    = {3},
  pages     = {1221--1232},
  abstract  = {The neo-sex chromosomes of {\textit{\uppercase{D}rosophila}} miranda constitute an ideal system to study the effects of recombination on patterns of genome evolution. Due to a fusion of an autosome with the {\uppercase{Y}}-chromosome, one homolog is transmitted clonally. Here, I compare patterns of molecular evolution of 18 protein-coding genes located on the recombining neo-X and their homologs on the nonrecombining neo-{\uppercase{Y}}-chromosome. The rate of protein evolution has significantly increased on the neo-Y lineage since its formation. Amino acid substitutions are accumulating uniformly among neo-{\uppercase{Y}}-linked genes, as expected if all loci on the neo-{\uppercase{Y}}-chromosome suffer from a reduced effectiveness of natural selection. In contrast, there is significant heterogeneity in the rate of protein evolution among neo-{\uppercase{X}}-linked genes, with most loci being under strong purifying selection and two genes showing evidence for adaptive evolution. This observation agrees with theory predicting that linkage limits adaptive protein evolution. Both the neo-X and the neo-{\uppercase{Y}}-chromosome show an excess of unpreferred codon substitutions over preferred ones and no difference in this pattern was observed between the chromosomes. This suggests that there has been little or no selection maintaining codon bias in the D. miranda lineage. A change in mutational bias toward AT substitutions also contributes to the decline in codon bias. The contrast in patterns of molecular evolution between amino acid mutations and synonymous mutations on the neo-sex-linked genes can be understood in terms of chromosome-specific differences in effective population size and the distribution of selective effects of mutations.},
  date      = {November 1, 2003},
  owner     = {bram},
  timestamp = {2008-05-30},
  url       = {http://www.genetics.org/cgi/content/abstract/165/3/1221},
}

@Article{McNamara2003,
  author    = {McNamara, John M. and Houston, Alasdair I. and Santos, Miguel Marques dos and Kokko, Hanna and Brooks, Rob},
  title     = {Quantifying male attractiveness},
  journal   = {Proceedings of the Royal Society of London. Series B: Biological Sciences},
  year      = {2003},
  volume    = {270},
  number    = {1527},
  pages     = {1925--1932},
  abstract  = {Genetic models of sexual selection are concerned with a dynamic process in which female preference and male trait values coevolve. We present a rigorous method for characterizing evolutionary endpoints of this process in phenotypic terms. In our phenotypic characterization the mate–choice strategy of female population members determines how attractive females should find each male, and a population is evolutionarily stable if population members are actually behaving in this way. This provides a justification of phenotypic explanations of sexual selection and the insights into sexual selection that they provide. Furthermore, the phenotypic approach also has enormous advantages over a genetic approach when computing evolutionarily stable mate–choice strategies, especially when strategies are allowed to be complex time–dependent preference rules. For simplicity and clarity our analysis deals with haploid mate–choice genetics and a male trait that is inherited phenotypically, for example by vertical cultural transmission. The method is, however, easily extendible to other cases. An example illustrates that the sexy son phenomenon can occur when there is phenotypic inheritance of the male trait.},
  comment   = {ESS; hardcopy},
  date      = {September 22, 2003},
  doi       = {10.1098/rspb.2003.2396},
  owner     = {bram},
  timestamp = {2010-04-28},
  url       = {http://rspb.royalsocietypublishing.org/content/270/1527/1925.abstract},
}

