@Article{Lucchesi2005,
  author    = {Lucchesi, John C. and Kelly, William G. and Panning, Barbara},
  title     = {Chromatin remodeling in dosage compensation},
  journal   = {Ann Rev Genet},
  year      = {2005},
  volume    = {39},
  number    = {1},
  pages     = {615--651},
  abstract  = {In many multicellular organisms, males have one {\uppercase{X}}-chromosome and females have two. Dosage compensation refers to a regulatory mechanism that insures the equalization of {\uppercase{X}}-linked gene products in males and females. The mechanism has been studied at the molecular level in model organisms belonging to three distantly related taxa; in these organisms, equalization is achieved by shutting down one of the two X chromosomes in the somatic cells of females, by decreasing the level of transcription of the two doses of {\uppercase{X}}-linked genes in females relative to males, or by increasing the level of transcription of the single dose of {\uppercase{X}}-linked genes in males. The study of dosage compensation in these different forms has revealed the existence of an amazing number of interacting chromatin remodeling mechanisms that affect the function of entire chromosomes.},
  owner     = {bram},
  timestamp = {2007-01-24},
  url       = {http://arjournals.annualreviews.org/doi/abs/10.1146/annurev.genet.39.073003.094210},
}

