@Article{Lemos2008,
  author    = {Lemos, Bernardo and Araripe, Luciana O. and Hartl, Daniel L.},
  title     = {Polymorphic {\uppercase{Y}} chromosomes Harbor Cryptic Variation with Manifold Functional Consequences},
  journal   = {Science},
  year      = {2008},
  volume    = {319},
  number    = {5859},
  pages     = {91--93},
  abstract  = {The paucity of polymorphisms in single-copy genes on the {\uppercase{Y}}-chromosome of {\textit{\uppercase{D}rosophila}} contrasts with data indicating that this chromosome has polymorphic phenotypic effects on sex ratio, temperature sensitivity, behavior, and fitness. We show that the {\uppercase{Y}}-chromosome of D. {\textit{melanogaster}} harbors substantial genetic diversity in the form of polymorphisms for genetic elements that differentially affect the expression of hundreds of {\uppercase{X}}-linked and autosomal genes. The affected genes are more highly expressed in males, more meagerly expressed in females, and more highly divergent between species. Functionally, they affect microtubule stability, lipid and mitochondrial metabolism, and the thermal sensitivity of spermatogenesis. Our findings provide a mechanism for adaptive phenotypic variation associated with the {\uppercase{Y}}-chromosome.},
  date      = {January 4, 2008},
  owner     = {bram},
  timestamp = {2008-01-04},
  url       = {http://www.sciencemag.org/cgi/content/abstract/319/5859/91},
}

