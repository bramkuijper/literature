@Article{Michl2005,
  author    = {Michl, G{\'a}bor and T{\"o}r{\"o}k, J{\'a}nos and P{\'e}czely, P{\'e}ter and Garamszegi, L{\'a}szl{\'o} Z. and Schwabl, Hubert},
