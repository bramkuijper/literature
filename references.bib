@Article{Ross1978,
  author    = {Ross, M. D.},
  title     = {The Evolution of Gynodioecy and Subdioecy},
  journal   = {Evolution},
  year      = {1978},
  volume    = {32},
  number    = {1},
  pages     = {174--188},
  abstract  = {Two previously studied monogenic models are combined with multiplicative selection interactions to give a digenic model of gynodioecy. In the first monogenic model recessive gene m controls male sterility and is maintained principally by overdominance for fertility, whereas in the second monogenic model nonrecessive gene P controls partial female sterility and may be maintained by overdominance for pollen fertility. The digenic model thus has two genotypes of hermaphrodites, five of partially female-sterile hermaphrodites ('subhermaphrodites'), one of females and two of partially female-sterile females ('subfemales'). As in the previous models, fitness values, pollen outcrossing rates and degrees to which male-fertiles function as ovule parents all vary with the population composition. Values for equilibrium genotype frequencies and other parameters are obtained numerically and show that where there is free recombination and some selfing, the digenic model maintains more male-steriles and subhermaphrodites than do the monogenic models of male sterility or partial female sterility, respectively, with equivalent selection and outcrossing values. Reduced recombination causes reduced frequencies of subfemales, hermaphrodites and some subhermaphrodite genotypes, and there are increased frequencies of females and also of other subhermaphrodite types, yielding increased total subhermaphrodite frequencies. With complete linkage both subfemale genotypes and certain subhermaphrodite genotypes are nearly always eliminated, and in some cases hermaphrodites are eliminated also, to give in this last case the female and two subhermaphrodite genotypes only. It is suggested that additional overdominant genes for partial female sterility and for male sterility would be selected and become completely linked to the first two to give the ultimate evolution of near dioecy from hermaphroditism via gynodioecy. There is now sufficient evidence to suggest that such evolution has probably occurred very frequently in nature. In contrast to this unstable type, other types of gynodioecy appear to be stable in evolution, and are probably associated with different modes of inheritance from that assumed in the model. In particular, stable gynodioecy often shows cytoplasmic inheritance, and it probably does not evolve towards dioecy because linkage cannot develop between nuclear female sterility and cytoplasmic male sterility.},
  issn      = {00143820},
  owner     = {bram},
  publisher = {Society for the Study of Evolution},
  timestamp = {2009-10-05},
  url       = {http://www.jstor.org/stable/2407418},
}

