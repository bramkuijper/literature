@Article{Kirkpatrick1986a,
  author    = {Kirkpatrick, Mark},
  title     = {Sexual selection and cycling parasites: a simulation study of {\uppercase{H}amilton's} hypothesis},
  journal   = {Journal of Theoretical Biology},
  year      = {1986},
  volume    = {119},
  number    = {3},
  pages     = {263--271},
  month     = apr,
  note      = {hardcopy; Tim},
  abstract  = {Hamilton has suggested that the coevolution of a population with its parasites can lead to oscillating directional selection, and that this form of selection can favor the adaptive evolution of female mating preferences. The hypothesis predicts that male secondary sexual characters will become exaggerated as an evolutionary side-effect of this process. The mechanism was studied by simulating a genetic model consisting of three diallelic haploid loci. Results show that genes for increase of male secondary sexual traits and the mating preference for them will not spread when rare. It is found, however, that if mating preferences for extreme male traits become sufficiently common, then a "runaway process" leading to increase of the male trait and the preference is possible. Some additional mechanism must be invoked in order to cause the preference to reach the frequency necessary for this to occur. Population fitness is not increased by evolution in this model.},
  owner     = {bram},
  timestamp = {2007-02-05},
  url       = {http://www.sciencedirect.com/science/article/B6WMD-4KDGR5D-2/2/f660a926e234f5cbd87003ed7eb6f7ee},
}

