@Article{Albert2005,
  author    = {Albert, Arianne Y. K. and Otto, Sarah P.},
  title     = {Sexual selection can resolve sex-linked sexual antagonism},
  journal   = {Science},
  year      = {2005},
  volume    = {310},
  number    = {5745},
  pages     = {119--121},
  abstract  = {Sexual selection is a potent evolutionary force. However, very few models have considered the evolution of female preferences for traits expressed in both sexes. Here we explore how female preferences coevolve with sexually antagonistic traits, which involve alleles that are beneficial to one sex but harmful to the other. We show that with a sexually antagonistic trait on the {\uppercase{X}}-chromosome (males {\uppercase{XY}}, females {\uppercase{XX}}), females evolve to prefer mates carrying alleles beneficial to daughters. In contrast, with a {\uppercase{Z}}-linked trait (males {\uppercase{ZZ}}, females {\uppercase{ZW}}), females more often evolve mating preferences for mates carrying alleles beneficial to sons (that is, flashy displays).},
  date      = {October 7, 2005},
  doi       = {10.1126/science.1115328},
  owner     = {bram},
  timestamp = {2007-01-04},
  url       = {http://www.sciencemag.org/cgi/content/abstract/310/5745/119},
}

