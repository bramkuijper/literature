@Article{Fukuda1997,
  author    = {Fukuda, Hideshi and Hijii, Naoki},
  title     = {Reproductive strategy of a woodwasp with no fungal symbionts, Xeris spectrum (Hymenoptera: Siricidae)},
  journal   = {Oecologia},
  year      = {1997},
  volume    = {112},
