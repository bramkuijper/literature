@Article{Vreys1997,
  author    = {Vreys, C. and Michiels, N. K.},
  title     = {Flatworms flatten to size up each other},
  journal   = {Proceedings of the Royal Society of London. Series B: Biological Sciences},
  year      = {1997},
  volume    = {264},
  number    = {1388},
  pages     = {1559--1564},
  abstract  = {When copulations are costly, fertilization is reciprocal and fecundity is positively related to size, hermaphrodites are expected to favour large partners, leading to size–assortative mating. Size–related mate choice has, however, never been observed in hermaphrodites. In the flatworm copulations cost time and are reciprocal, and size is a positive predictor of female fecundity. Every copulation is preceded by a phase in which one partner glides on top of the other and both spread out and flatten, suggesting that partners assess each other's size. A total of 124 copulating pairs collected on four different dates, proved that mating is size–assorted in the field. In experiments with groups, more copulations took place between equally sized individuals than were expected when matings were random. In experiments with pairs, partners of different size exhibited twice as many mating attempts for the first copulation than did partners of the same size. We conclude that employs a unique kind of pre–copulatory `flattening' behaviour as a mechanism to signal as well as to assess relative size. This does not only confirm that hermaphrodites can mate assortatively when certain assumptions are met, it also proves that even lower invertebrates can show active mate choice.},
  date      = {November 22, 1997},
  doi       = {10.1098/rspb.1997.0217},
  owner     = {bram},
  timestamp = {2009-09-21},
  url       = {http://rspb.royalsocietypublishing.org/content/264/1388/1559.abstract},
}

