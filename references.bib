@Article{Carvalho2005,
  author    = {Carvalho, Antonio Bernardo and Clark, Andrew G.},
  title     = {{\uppercase{Y}}-chromosome of D. pseudoobscura Is Not Homologous to the Ancestral {\textit{\uppercase{D}rosophila}} Y},
  journal   = {Science},
  year      = {2005},
  volume    = {307},
  number    = {5706},
  pages     = {108--110},
  abstract  = {We report a genome-wide search of {\uppercase{Y}}-linked genes in {\textit{\uppercase{D}rosophila}} pseudoobscura. All six identifiable orthologs of the D. {\textit{melanogaster}} {\uppercase{Y}}-linked genes have autosomal inheritance in D. pseudoobscura. Four orthologs were investigated in detail and proved to be {\uppercase{Y}}-linked in D. guanche and D. bifasciata, which shows that less than 18 million years ago the ancestral {\textit{\uppercase{D}rosophila}} {\uppercase{Y}}-chromosome was translocated to an autosome in the D. pseudoobscura lineage. We found 15 genes and pseudogenes in the current Y of D. pseudoobscura, and none are shared with the D. {\textit{melanogaster}} Y. Hence, the {\uppercase{Y}}-chromosome in the D. pseudoobscura lineage appears to have arisen de novo and is not homologous to the D. {\textit{melanogaster}} Y.},
  date      = {January 7, 2005},
  owner     = {bram},
  timestamp = {2008-05-30},
  url       = {http://www.sciencemag.org/cgi/content/abstract/307/5706/108},
}

