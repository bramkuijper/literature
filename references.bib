@Article{Otto2009,
  author    = {Otto, Sarah P.},
  title     = {The evolutionary enigma of sex},
  journal   = {The American Naturalist},
  year      = {2009},
  volume    = {174},
  number    = {S1},
  pages     = {S1-S14},
  abstract  = {Abstract: Sexual reproduction entails a number of costs, and yet the majority of eukaryotes engage in sex, at least occasionally. In this article, I review early models to explain the evolution of sex and why they failed to do so. More recent efforts have attempted to account for the complexities of evolution in the real world, with selection that varies over time and space, with differences among individuals in the tendency to reproduce sexually, and with populations that are limited in size. These recent efforts have clarified the conditions that are most likely to explain why sex is so common, as exemplified by the articles in this symposium issue of the American Naturalist.},
  doi       = {10.1086/599084},
  owner     = {bram},
  timestamp = {2010-08-19},
  url       = {http://www.journals.uchicago.edu/doi/abs/10.1086/599084},
}

