@Article{Lande1982,
  author    = {Lande, Russell},
  title     = {A quantitative genetic theory of life history evolution},
  journal   = {Ecology},
  year      = {1982},
  volume    = {63},
  number    = {3},
  pages     = {607--615},
  month     = jun,
  abstract  = {Dynamic models of quantitative (polygenic) characters are more generally applicable in the analysis of life history evolution than are static optimization methods or one and two locus genetic models. A dynamic theory of life history evolution is derived by synthesizing population demography with quantitative genetics. In a population under weak selection with a nearly stable age distribution, the relative fitness of individuals with a particular life history phenotype can be approximated as an average of age-specific relative fecundity and mortality rates, weighted respectively by the present productivity and future reproductive value of each age-class. An adaptive topography is constructed showing that, with phenotype- and age-specific fecundity and mortality rates constant in time, evolution of the mean life history maximizes the intrinsic rate of increase of a population. However, the rate and direction of evolution in response to selection are strongly influenced by genetic correlations among characters. Negative genetic correlations among major components of fitness are often obscured phenotypically by positive environmental correlations, but commonly constitute the ultimate constraint on life history evolution, as illustrated by artificial selection experiments. Methods are suggested for measuring selective forces and evolutionary constraints that effect life history characters in natural populations.},
  doi       = {10.2307/1936778},
  issn      = {00129658},
  owner     = {bram},
  publisher = {Ecological Society of America},
  timestamp = {2014-02-17},
  url       = {http://dx.doi.org/10.2307/1936778},
}

@Article{Lyttle1982,
  author    = {Lyttle, Terrence W.},
  title     = {A Theoretical Analysis of the Effects of Sex Chromosome Aneuploidy on X and {\uppercase{Y}}-chromosome Meiotic Drive},
  journal   = {Evolution},
  year      = {1982},
  volume    = {36},
  number    = {4},
  pages     = {822--831},
  month     = jul,
  abstract  = {A general model is developed which describes the dynamics of populations segregating for both sex chromosome meiotic drive and extra Y chromosomes (sex chromosome aneuploidy). Four models of sex chromosome drive are considered, specified by (1) whether it is the Y or X which is driven (recovered in excess in the heterogametic sex), and (2) whether it is the absence of this chromosome or the presence of the alternative one which leads to the elimination of a gamete. The cases of {\uppercase{Y}}-chromosome drive each have a characteristic threshold value of drive strength above which both aneuploidy and meiotic drive remain segregating in polymorphic equilibrium, and the sex ratio is returned much closer to the optimal 1:1 than would be the case with {\uppercase{Y}}-chromosome drive alone. Drive strength below this threshold value leads to loss of aneuploidy. For {\uppercase{X}}-chromosome drive the presence of aneuploidy is not stable. A particularly interesting prediction is that when the presence of a Y saves a gamete (the YS model) and XXYY fitness exceeds half that of {\uppercase{XX}} genotypes, the sex ratio should actually become less deviant as the strength of drive increases, a result opposite those of the other cases considered. Moreover, when drive is complete, the YS model predicts that aneuploid XYY and XXYY genotypes should become fixed, restoring the sex ratio to 1:1. This could be considered as a case of karyotype evolution. These results should hold for species of {\textit{\uppercase{D}rosophila}}, for which they were originally derived, and for other organisms with similar sex determination systems. The possible involvement of drive and aneuploidy in the evolution of supernumerary chromosomes (such as the B chromosomes of many plants and animals) and unusual sex chromosome karyotypes, particularly in insects, is also considered.},
  issn      = {0014-3820},
  owner     = {bram},
  publisher = {Society for the Study of Evolution},
  timestamp = {2006-11-17},
  url       = {http://links.jstor.org/sici?sici=0014-3820%28198207%2936%3A4%3C822%3AATAOTE%3E2.0.CO%3B2-F},
}

