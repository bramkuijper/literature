@Article{Fagegaltier2004,
  author    = {Fagegaltier, Delphine and Baker, Bruce S.},
  title     = {{\uppercase{X}}-chromosome Sites Autonomously Recruit the Dosage Compensation Complex in {\textit{\uppercase{D}rosophila}} Males},
  journal   = {PLoS Biology},
  year      = {2004},
  volume    = {2},
  number    = {11},
  pages     = {e341},
  abstract  = {It has been proposed that dosage compensation in {\textit{\uppercase{D}rosophila}} males occurs by binding of two core proteins, MSL-1 and MSL-2, to a set of 35&#8211;40 {\uppercase{X}}-chromosome &#8220;entry sites&#8221; that serve to nucleate mature complexes, termed compensasomes, which then spread to neighboring sequences to double expression of most {\uppercase{X}}-linked genes. Here we show that any piece of the {\uppercase{X}}-chromosome with which compensasomes are associated in wild-type displays a normal pattern of compensasome binding when inserted into an autosome, independently of the presence of an entry site. Furthermore, in chromosomal rearrangements in which a piece of {\uppercase{X}}-chromosome is inserted into an autosome, or a piece of autosome is translocated to the {\uppercase{X}}-chromosome, we do not observe spreading of compensasomes to regions of autosomes that have been juxtaposed to {\uppercase{X}}-chromosomal material. Taken together these results suggest that spreading is not involved in dosage compensation and that nothing distinguishes an entry site from the other {\uppercase{X}}-chromosome sites occupied by compensasomes beyond their relative affinities for compensasomes. We propose a new model in which the distribution of compensasomes along the {\uppercase{X}}-chromosome is achieved according to the hierarchical affinities of individual binding sites.},
  date      = {November 01, 2004},
  owner     = {bram},
  timestamp = {2007-01-24},
  url       = {http://dx.doi.org/10.1371%2Fjournal.pbio.0020341},
}

@Article{Piganeau2004,
  author    = {Piganeau, Gwenael and Gardner, Michael and Eyre-Walker, Adam},
  title     = {A broad survey of recombination in animal mitochondria},
  journal   = {Molecular Biology and Evolution},
  year      = {2004},
  volume    = {21},
  number    = {12},
  pages     = {2319--2325},
  abstract  = {Recombination in mitochondrial DNA (mtDNA) remains a controversial topic. Here we present a survey of 279 animal mtDNA data sets, of which 12 were from asexual species. Using four separate tests, we show that there is widespread evidence of recombination; for one test as many as 14.2% of the data sets reject a model of clonal inheritance and in several data sets, including primates, the recombinants can be identified visually. We show that none of the tests give significant results for obligate clonal species (apomictic parthogens) and that the sexual species show significantly greater evidence of recombination than asexual species. For some data sets, such as Macaca nemestrina, additional data sets suggest that the recombinants are not artifacts. For others, it cannot be determined whether the recombinants are real or produced by laboratory error. Either way, the results have important implications for how mtDNA is sequenced and used.},
  doi       = {10.1093/molbev/msh244},
  eprint    = {http://mbe.oxfordjournals.org/content/21/12/2319.full.pdf+html},
  owner     = {bram},
  timestamp = {2015-04-28},
  url       = {http://dx.doi.org/10.1093/molbev/msh244},
}

