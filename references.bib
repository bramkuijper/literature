@Article{Lanfear2007,
  author   = {Lanfear, Robert and Thomas, Jessica A. and Welch, John J. and Brey, Thomas and Bromham, Lindell},
  title    = {Metabolic rate does not calibrate the molecular clock},
  journal  = {Proceedings of the National Academy of Sciences},
  year     = {2007},
  volume   = {104},
  number   = {39},
  pages    = {15388-15393},
  abstract = {Rates of molecular evolution vary widely among lineages, but the causes of this variation remain poorly understood. It has been suggested that mass-specific metabolic rate may be one of the key factors determining the rate of molecular evolution, and that it can be used to derive “corrected” molecular clocks. However, previous studies have been hampered by a paucity of mass-specific metabolic rate data and have been largely limited to vertebrate taxa. Using mass-specific metabolic rate measurements and DNA sequence data for >300 metazoan species for 12 different genes, we find no evidence that mass-specific metabolic rate drives substitution rates. The mechanistic basis of the metabolic rate hypothesis is discussed in light of these findings.},
  date     = {2016-07-17},
  doi      = {10.1073/pnas.0703359104},
  eprint   = {http://www.pnas.org/content/104/39/15388.full.pdf},
  url      = {http://www.pnas.org/content/104/39/15388.abstract},
}

