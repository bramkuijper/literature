@Article{Lin2007,
  author    = {Lin, Chin-Yo and Vega, Vinsensius B and Thomsen, Jane S and Zhang, Tao and Kong, Say Li and Xie, Min and Chiu, Kuo Ping and Lipovich, Leonard and Barnett, Daniel H and Stossi, Fabio and Yeo, Ailing and George, Joshy and Kuznetsov, Vladimir A and Lee, Yew Kok and Charn, Tze Howe and Palanisamy, Nallasivam and Miller, Lance D and Cheung, Edwin and Katzenellenbogen, Benita S and Ruan, Yijun and Bourque, Guillaume and Wei, Chia-Lin and Liu, Edison T},
  title     = {Whole-Genome Cartography of Estrogen Receptor {$\alpha$} Binding Sites},
  journal   = {PLoS Genetics},
  year      = {2007},
  volume    = {3},
  number    = {6},
  pages     = {e87--},
  month     = jun,
  abstract  = {<title>Author Summary</title><sec id="st1"><title/>Estrogen receptors (ERs) play key roles in facilitating the transcriptional effects of hormone functions in target tissues. To obtain a genome-wide view of ERÎ± binding sites, we applied chromatin immunoprecipitation coupled with a cloning and sequencing strategy using chromatin immunoprecipitation pair end-tagging technology to map ERÎ± binding sites in MCF-7 human breast cancer cells. We identified 1,234 high quality ERÎ± binding sites in the human genome and demonstrated that the binding sites are frequently adjacent to genes significantly associated with breast cancer disease status and outcome. The mapping results also revealed that ERÎ± can influence gene expression across distances of up to 100 kilobases or more, that genes that are induced or repressed utilize sites in different regions relative to the transcript (suggesting different mechanisms of action), and that ERÎ± binding sites are only modestly conserved in evolution. Using computational approaches, we identified potential interactions with other transcription factor binding sites adjacent to the ERÎ± binding elements. Taken together, these findings suggest complex but definable rules governing ERÎ± binding and gene regulation and provide a valuable dataset for mapping the precise control nodes for one of the most important nuclear hormone receptors in breast cancer biology.</sec>},
  doi       = {10.1371/journal.pgen.0030087},
  owner     = {bram},
  publisher = {Public Library of Science},
  timestamp = {2012-05-07},
  url       = {http://dx.plos.org/10.1371%2Fjournal.pgen.0030087},
}

