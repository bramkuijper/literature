@Article{Courtiol2016,
  author    = {Courtiol, Alexandre and Etienne, LoÃ¯c and Feron, Romain and Godelle, Bernard and Rousset, FranÃ§ois},
  title     = {The Evolution of Mutual Mate Choice under Direct Benefits},
  journal   = {The American Naturalist},
  year      = {2016},
  volume    = {188},
  number    = {5},
  pages     = {521--538},
  month     = nov,
  issn      = {0003-0147},
  abstract  = {AbstractIn nature, the intensity of mate choice (i.e., choosiness) is highly variable within and between sexes. Despite growing empirical evidence of male and/or mutual mate choice, theoretical investigations of the joint evolution of female and male choosiness are few. In addition, previous approaches have often assumed an absence of trade-off between the direct benefits per mating and the lower mating rate that results from being choosy. Here we model the joint evolution of female and male choosiness when it is solely ruled by this fundamental trade-off. We show that this trade-off can generate a diversity of stable combinations of choosiness. Mutual mate choice can evolve only if both females and males exhibit long latency after mating. Furthermore, we show that an increase in choosiness in one sex does not necessarily prevent the evolution of mutual mate choice; the outcome depends on details shaping the trade-off: the life history, the decision rule for mate choice, and how the fecundity of a pair is shaped by the quality of both individuals. Last, we discuss the power of the sensitivity of the relative searching time (i.e., of the proportion of a lifetime spent searching for mates) as a predictor of the joint evolution of choosiness.
AbstractIn nature, the intensity of mate choice (i.e., choosiness) is highly variable within and between sexes. Despite growing empirical evidence of male and/or mutual mate choice, theoretical investigations of the joint evolution of female and male choosiness are few. In addition, previous approaches have often assumed an absence of trade-off between the direct benefits per mating and the lower mating rate that results from being choosy. Here we model the joint evolution of female and male choosiness when it is solely ruled by this fundamental trade-off. We show that this trade-off can generate a diversity of stable combinations of choosiness. Mutual mate choice can evolve only if both females and males exhibit long latency after mating. Furthermore, we show that an increase in choosiness in one sex does not necessarily prevent the evolution of mutual mate choice; the outcome depends on details shaping the trade-off: the life history, the decision rule for mate choice, and how the fecundity of a pair is shaped by the quality of both individuals. Last, we discuss the power of the sensitivity of the relative searching time (i.e., of the proportion of a lifetime spent searching for mates) as a predictor of the joint evolution of choosiness.},
  comment   = {doi: 10.1086/688658},
  doi       = {10.1086/688658},
  owner     = {bram},
  publisher = {The University of Chicago Press},
  timestamp = {2018.04.12},
  url       = {https://doi.org/10.1086/688658},
}

@Article{Cavoto2018,
  author    = {Cavoto, E. and Neuenschwander, S. and Goudet, J. and Perrin, N.},
  title     = {Sex-antagonistic genes, XY recombination and feminized Y chromosomes},
  journal   = {Journal of Evolutionary Biology},
  year      = {2018},
  volume    = {31},
  number    = {3},
  pages     = {416--427},
  month     = dec,
  issn      = {1010-061X},
  abstract  = {Abstract The canonical model of sex?chromosome evolution predicts that sex?antagonistic (SA) genes play an instrumental role in the arrest of XY recombination and ensuing Y chromosome degeneration. Although this model might account for the highly differentiated sex chromosomes of birds and mammals, it does not fit the situation of many lineages of fish, amphibians or nonavian reptiles, where sex chromosomes are maintained homomorphic through occasional XY recombination and/or high turnover rates. Such situations call for alternative explanatory frameworks. A crucial issue at stake is the effect of XY recombination on the dynamics of SA genes and deleterious mutations. Using individual?based simulations, we show that a complete arrest of XY recombination actually benefits females, not males. Male fitness is maximized at different XY recombination rates depending on SA selection, but never at zero XY recombination. This should consistently favour some level of XY recombination, which in turn generates a recombination load at sex?linked SA genes. Hill?Robertson interferences with deleterious mutations also impede the differentiation of sex?linked SA genes, to the point that males may actually fix feminized phenotypes when SA selection and XY recombination are low. We argue that sex chromosomes might not be a good localization for SA genes, and sex conflicts seem better solved through the differential expression of autosomal genes.},
  comment   = {doi: 10.1111/jeb.13235},
  doi       = {10.1111/jeb.13235},
  keywords  = {mutational load, recombination load, sexâantagonistic genes, sexâchromosome evolution, XY recombination},
  owner     = {bram},
  publisher = {Wiley/Blackwell (10.1111)},
  timestamp = {2018.04.13},
  url       = {https://doi.org/10.1111/jeb.13235},
}

@Article{Stoeck2011,
  author    = {St{\"o}ck, Matthias and Horn, Agnes and Grossen, Christine and Lindtke, Dorothea and Sermier, Roberto and Betto-Colliard, Caroline and Dufresnes, Christophe and Bonjour, Emmanuel and Dumas, Z and Luquet, Emilien and Maddalena, Tiziano and Sousa, Helena Clavero and Martinez-Solano, Inigo and Perrin, Nicolas},
  title     = {Ever-young sex chromosomes in {\uppercase{E}uropean} tree frogs},
  journal   = {PLoS Biology},
  year      = {2011},
  volume    = {9},
  number    = {5},
  pages     = {e1001062},
  month     = may,
  abstract  = {Author Summary Non-recombining sex chromosomes, such as the Y chromosome, are expected to degenerate over evolutionary times because they accumulate deleterious mutations that cannot be corrected by recombination with a pristine copy. In most cold-blooded vertebrates, such as frogs, however, sex chromosomes are undifferentiated. Why is that so? On the one hand, the âhigh-turnoverâ hypothesis holds that these sex chromosomes are regularly replaced before they had time to decay. On the other hand, the âfountain-of-youthâ hypothesis posits that they are regularly rejuvenated by X-Y recombination in sex-reversed XY females. Here, we show that three species of tree frogs that diverged more than 5.4 million years ago share the same pair of undifferentiated sex chromosomes. Although male recombination stopped before species divergence, X and Y alleles show no differentiation, and cluster by species, not gametologs. We conclude that their sex chromosome homomorphy is not due to a recent turnover but is maintained over long evolutionary times by occasional recombination. Such rare episodes of X-Y recombination are expected to have long-lasting consequences on the evolution of sex chromosomes and sex antagonistic genes.},
  doi       = {10.1371/journal.pbio.1001062},
  owner     = {bram},
  publisher = {Public Library of Science},
  timestamp = {2018.04.13},
  url       = {https://doi.org/10.1371/journal.pbio.1001062},
}

@Article{Charlesworth2017,
  author    = {Charlesworth, Deborah},
  title     = {Evolution of recombination rates between sex chromosomes},
  journal   = {Philosophical Transactions of the Royal Society B: Biological Sciences},
  year      = {2017},
  volume    = {372},
  number    = {1736},
  issn      = {0962-8436},
  abstract  = {In species with genetic sex-determination, the chromosomes carrying the sex-determining genes have often evolved non-recombining regions and subsequently evolved the full set of characteristics denoted by the term {\textquoteleft}sex chromosomes{\textquoteright}. These include size differences, creating chromosomal heteromorphism, and loss of gene functions from one member of the chromosome pair. Such characteristics and changes have been widely reviewed, and underlie molecular genetic approaches that can detect sex chromosome regions. This review deals mainly with the evolution of new non-recombining regions, focusing on how certain evolutionary situations select for suppressed recombination (rather than the proximate mechanisms causing suppressed recombination between sex chromosomes). Particularly important is the likely involvement of sexually antagonistic polymorphisms in genome regions closely linked to sex-determining loci. These may be responsible for the evolutionary strata of sex chromosomes that have repeatedly formed by recombination suppression evolving across large genome regions. More studies of recently evolved non-recombining sex-determining regions should help to test this hypothesis empirically, and may provide evidence about whether other situations can sometimes lead to sex-linked regions evolving. Similarities with other non-recombining genome regions are discussed briefly, to illustrate common features of the different cases, though no general properties apply to all of them.This article is part of the themed issue {\textquoteleft}Evolutionary causes and consequences of recombination rate variation in sexual organisms{\textquoteright}.},
  doi       = {10.1098/rstb.2016.0456},
  eprint    = {http://rstb.royalsocietypublishing.org/content/372/1736/20160456.full.pdf},
  owner     = {bram},
  publisher = {The Royal Society},
  timestamp = {2018.04.13},
  url       = {http://rstb.royalsocietypublishing.org/content/372/1736/20160456},
}

@Article{Grossen,
  author    = {Christine Grossen and Samuel Neuenschwander and Nicolas Perrin},
  journal   = {Evolution},
  title     = {The evolution of {\uppercase{XY}} recombination: sexually antagonistic selection versus deleterious mutation load},
  year      = {2012},
  number    = {10},
  pages     = {3155-3166},
  volume    = {66},
  abstract  = {Recombination arrest between X and Y chromosomes, driven by sexually antagonistic genes, is expected to induce their progressive differentiation. However, in contrast to birds and mammals (which display the predicted pattern), most coldâblooded vertebrates have homomorphic sex chromosomes. Two main hypotheses have been proposed to account for this, namely high turnover rates of sexâdetermining systems and occasional XY recombination. Using individualâbased simulations, we formalize the evolution of XY recombination (here mediated by sex reversal; the âfountainâofâyouthâ model) under the contrasting forces of sexually antagonistic selection and deleterious mutations. The shift between the domains of elimination and accumulation occurs at much lower selection coefficients for the Y than for the X. In the absence of dosage compensation, mildly deleterious mutations accumulating on the Y depress male fitness, thereby providing incentives for XY recombination. Under our settings, this occurs via âdemasculinizationâ of the Y, allowing recombination in XY (sexâreversed) females. As we also show, this generates a conflict with the X, which coevolves to oppose sex reversal. The resulting rare events of XY sex reversal are enough to purge the Y from its load of deleterious mutations. Our results support the âfountain of youthâ as a plausible mechanism to account for the maintenance of sexâchromosome homomorphy.},
  doi       = {10.1111/j.1558-5646.2012.01661.x},
  eprint    = {https://onlinelibrary.wiley.com/doi/pdf/10.1111/j.1558-5646.2012.01661.x},
  keywords  = {Deleterious mutations, fountain of youth, recombination, sex chromosomes, sex determination, sex reversal, sexually antagonistic genes},
  owner     = {bram},
  timestamp = {2018.04.13},
  url       = {https://onlinelibrary.wiley.com/doi/abs/10.1111/j.1558-5646.2012.01661.x},
}

