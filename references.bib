}

@Article{Ju2014,
  author    = {Ju, Young Seok and Alexandrov, Ludmil B and Gerstung, Moritz and Martincorena, Inigo and Nik-Zainal, Serena and Ramakrishna, Manasa and Davies, Helen R and Papaemmanuil, Elli and Gundem, Gunes and Shlien, Adam and Bolli, Niccolo and Behjati, Sam and Tarpey, Patrick S and Nangalia, Jyoti and Massie, Charles E and Butler, Adam P and Teague, Jon W and Vassiliou, George S and Green, Anthony R and Du, Ming-Qing and Unnikrishnan, Ashwin and Pimanda, John E and Teh, Bin Tean and Munshi, Nikhil and Greaves, Mel and Vyas, Paresh and El-Naggar, Adel K and Santarius, Tom and Collins, V Peter and Grundy, Richard and Taylor, Jack A and Hayes, D Neil and Malkin, David and , and , and , and Foster, Christopher S and Warren, Anne Y and Whitaker, Hayley C and Brewer, Daniel and Eeles, Rosalind and Cooper, Colin and Neal, David and Visakorpi, Tapio and Isaacs, William B and Bova, G Steven and Flanagan, Adrienne M and Futreal, P Andrew and Lynch, Andy G and Chinnery, Patrick F and McDermott, Ultan and Stratton, Michael R and Campbell, Peter J},
  title     = {Origins and functional consequences of somatic mitochondrial DNA mutations in human cancer},
  journal   = {eLife},
  year      = {2014},
  volume    = {3},
  pages     = {e02935},
  abstract  = {Recent sequencing studies have extensively explored the somatic alterations present in the nuclear genomes of cancers. Although mitochondria control energy metabolism and apoptosis, the origins and impact of cancer-associated mutations in mtDNA are unclear. In this study, we analyzed somatic alterations in mtDNA from 1675 tumors. We identified 1907 somatic substitutions, which exhibited dramatic replicative strand bias, predominantly C \&gt; T and A \&gt; G on the mitochondrial heavy strand. This strand-asymmetric signature differs from those found in nuclear cancer genomes but matches the inferred germline process shaping primate mtDNA sequence content. A number of mtDNA mutations showed considerable heterogeneity across tumor types. Missense mutations were selectively neutral and often gradually drifted towards homoplasmy over time. In contrast, mutations resulting in protein truncation undergo negative selection and were almost exclusively heteroplasmic. Our findings indicate that the endogenous mutational mechanism has far greater impact than any other external mutagens in mitochondria and is fundamentally linked to mtDNA replication. DOI: http://dx.doi.org/10.7554/eLife.02935.001 Author keywordsResearch organism},
  doi       = {10.7554/eLife.02935},
  editor    = {Golub, Todd and Provenzano, Elena and van de Vijver, Marc and Richardson, Andrea L and Purdie, Colin and Pinder, Sarah and MacGrogan, Gaetan and Vincent-Salomon, Anne and Larsimont, Denis and Grabau, Dorthe and Sauer, Torill and Garred, {\O}ystein and Ehinger, Anna and Van den Eynden, Gert G and van Deurzen, C.H.M. and Salgado, Roberto and Brock, Jane E and Lakhani, Sunil R and Giri, Dilip D and Arnould, Laurent and Jacquemier, Jocelyne and Treilleux, Isabelle and Caldas, Carlos and Chin, Suet-Feung and Fatima, Aquila and Thompson, Alastair M and Stenhouse, Alasdair and Foekens, John and Martens, John and Sieuwerts, Anieta and Brinkman, Arjen and Stunnenberg, Henk and Span, Paul N. and Sweep, Fred and Desmedt, Christine and Sotiriou, Christos and Thomas, Gilles and Broeks, Annegein and Langerod, Anita and Aparicio, Samuel and Simpson, Peter and Veer, Laura van {\textquoteright}t and Eyfj{\"o}rd, J{\'o}runn Erla and Hilmarsdottir, Holmfridur and Jonasson, Jon G and B{\o}rresen-Dale, Anne-Lise and Michael Lee, Ming Ta and Wong, Bernice Huimin and Tee Tan, Benita Kiat and Hooijer, Gerrit K.J. and Malcovati, Luca and Tauro, Sudhir and Boultwood, Jacqueline and Pellagatti, Andrea and Groves, Michael and Sternberg, Alex and Gambacorti-Passerini, Carlo and Vyas, Paresh and Hellstrom-Lindberg, Eva and Bowen, David and Cross, Nicholas CP and Green, Anthony R and Cazzola, Mario and Cooper, Colin and Eeles, Rosalind and Wedge, David and Van Loo, Peter and Gundem, Gunes and Alexandrov, Ludmil and Kremeyer, Barbara and Butler, Adam and Lynch, Andrew and Edwards, Sandra and Camacho, Niedzica and Massie, Charlie and Kote-Jarai, ZSofia and Dennis, Nening and Merson, Sue and Zamora, Jorge and Kay, Jonathan and Corbishley, Cathy and Thomas, Sarah and Nik-Zainai, Serena and O{\textquoteright}Meara, Sarah and Matthews, Lucy and Clark, Jeremy and Hurst, Rachel and Mithen, Richard and Cooke, Susanna and Raine, Keiran and Jones, David and Menzies, Andrew and Stebbings, Lucy and Hinton, Jon and Teague, Jon and McLaren, Stuart and Mudie, Laura and Hardy, Claire and Anderson, Elizabeth and Joseph, Olivia and Goody, Victoria and Robinson, Ben and Maddison, Mark and Gamble, Stephen and Greenman, Christopher and Berney, Dan and Hazell, Steven and Livni, Naomi and Fisher, Cyril and Ogden, Christopher and Kumar, Pardeep and Thompson, Alan and Woodhouse, Christopher and Nicol, David and Mayer, Erik and Dudderidge, Tim and Shah, Nimish and Gnanapragasam, Vincent and Campbell, Peter and Futreal, Andrew and Easton, Douglas and Warren, Anne Y and Foster, Christopher and Stratton, Michael and Whitaker, Hayley and McDermott, Ultan and Brewer, Daniel and Neal, David},
  isbn      = {2050-084X},
