@Article{Boake1998,
  author    = {Boake, Christine R. B. and Gavrilets, Sergey},
  journal   = {The American Naturalist},
  title     = {On the evolution of premating isolation after a founder event},
  year      = {1998},
  number    = {5},
  pages     = {706--716},
  volume    = {152},
  abstract  = {ABSTRACT We present a new simple model for the evolution of premating reproductive isolation. Using this model we first analyze the level of genetic variability maintained by mutation in a large stable population. Then we consider the plausibility of the evolution of strong premating reproductive isolation after a founder event. We demonstrate that after a founder event a new adaptive combination of genes may rise to high frequencies in the presence of an old combination of genes. We compare the probabilities of speciation after a founder event with those in a stable population and with those when reproductive isolation is due to viability selection against hybrids. We argue that premating reproductive isolation is more efficient than postmating reproductive isolation in maintaining the integrity of sympatric species. This might have contributed to the pattern of stronger premating isolation than postmating isolation between closely related pairs of sympatric species.},
  doi       = {10.1086/286201},
  owner     = {bram},
  timestamp = {2010-05-07},
  url       = {http://www.journals.uchicago.edu/doi/abs/10.1086/286201},
}

