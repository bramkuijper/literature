  publisher = {The University of Chicago Press},
  timestamp = {2006-10-31},
  url       = {http://links.jstor.org/sici?sici=0003-0147%28198503%29125%3A3%3C412%3AEGSOMS%3E2.0.CO%3B2-Y},
}

