@Article{McElreavey1997,
  author    = {McElreavey, Ken and Fellous, Marc},
  title     = {Sex-Determining Genes},
  journal   = {Trends in Endocrinology \& Metabolism},
  year      = {1997},
  volume    = {8},
  number    = {9},
  pages     = {342--346},
  month     = nov,
  abstract  = {Recently, a number of genes have been identified that are associated with a failure of human sex determination, including WT1, DAX-1, SOX9, ATRX, and the {\uppercase{Y}}-linked testis determination gene, SRY. Most cases of human sex reversal, {\uppercase{XY}} females and {\uppercase{XX}} males, do not, however, appear to be caused by mutations in these genes. This review highlights recent advances in this field and discusses the prospects of identifying genes in the sex-determining pathway. (Trends Endocrinol Metab 1997;9:342-345). (c) 1997, Elsevier Science Inc.},
